---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { dicts, routes, pageLangs, LANG_INFO, type Lang, type PageId } from "../i18n";

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Appended to the page's route in every language, e.g. "/epic-4" for an epic of the roadmap. */
  subpath?: string;
}

const { lang, page, title: rawTitle, description: rawDescription, jsonLd = [], noindex = false, subpath = "" } = Astro.props;
const t = dicts[lang];
// Search results show about 60 characters of a title and 160 of a description. A title that only
// says "Features — Mumcord" gets what Mumcord is; a long description ends at a sentence or a word.
const MAX_TITLE = 62;
const MAX_DESC = 160;
const brand = `Mumcord, ${t.meta.altClient}`;
const titled = / — Mumcord$/.test(rawTitle) ? rawTitle.replace(/ — Mumcord$/, ` — ${brand}`) : /Mumcord/.test(rawTitle) ? rawTitle : `${rawTitle} · Mumcord`;
const title = page !== "home" && titled.length <= MAX_TITLE ? titled : rawTitle;
const clamp = (text: string) => {
  if (text.length <= MAX_DESC) return text;
  const cut = text.slice(0, MAX_DESC);
  const sentence = Math.max(cut.lastIndexOf(". "), cut.lastIndexOf("! "), cut.lastIndexOf("? "));
  if (sentence >= 80) return cut.slice(0, sentence + 1);
  return `${cut.slice(0, cut.lastIndexOf(" ")).replace(/[,;:–—-]$/, "")}…`;
};
const description = clamp(rawDescription);
const site = Astro.site!;
const canonical = new URL(routes[page][lang] + subpath, site).href;
const alternates = pageLangs(page).map((l) => ({ lang: l, href: new URL(routes[page][l] + subpath, site).href }));
const ogImage = new URL("/og.jpg", site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mumcord" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mumcord" />
    <meta property="og:locale" content={t.locale} />
    {pageLangs(page).filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_INFO[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0e0a26" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header lang={lang} page={page} subpath={subpath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
