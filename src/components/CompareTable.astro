---
import type { Lang } from "../i18n";
import { comparePage, COMPARE_CELLS, COMPARE_FOOT } from "../lib/compare";

interface Props {
  lang: Lang;
  /** Only these row ids, without group heads and notes (the home page's short table). */
  only?: string[];
}
const { lang, only } = Astro.props;
const t = comparePage[lang];
const compact = !!only;
const word = { y: t.yes, p: t.partly, s: t.soon, n: t.no } as const;
type Cell = keyof typeof word;
const cells = (group: string, row: string) => [...(COMPARE_CELLS[group]?.[row] ?? "nnn")] as Cell[];
// The short table keeps the order of `only` and leaves out the group rows.
const groups = only
  ? [{ id: "", title: "", rows: only.flatMap((id) => t.groups.flatMap((g) => g.rows.filter((r) => r.id === id).map((r) => ({ ...r, group: g.id })))) }]
  : t.groups.map((g) => ({ ...g, rows: g.rows.map((r) => ({ ...r, group: g.id })) }));
---

<div class:list={["cmp-wrap", { "cmp-compact": compact }]} data-reveal>
  <table class="cmp-table">
    <caption class="sr-only">{t.title}</caption>
    <colgroup>
      <col class="cmp-col-feature" />
      <col />
      <col class="cmp-col-mumcord" />
      <col class="cmp-col-peer" />
    </colgroup>
    <thead>
      <tr>
        <td></td>
        {
          t.columns.map((c, i) => (
            <th scope="col" class:list={{ "cmp-ours": i > 0 }}>
              <span class="cmp-col-name">{c.name}</span>
              <span class="cmp-col-sub">{c.sub}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    {
      groups.map((g) => (
        <tbody id={g.id || undefined}>
          {!compact && <tr class="cmp-group">
            <th scope="colgroup" colspan="4">{g.title}</th>
          </tr>}
          {g.rows.map((r) => (
            <tr>
              <th scope="row">
                <span class="cmp-feature">{r.feature}</span>
                {!compact && r.note && <span class="cmp-note">{COMPARE_FOOT[r.id] && <span class="cmp-foot">* </span>}{r.note}</span>}
              </th>
              {cells(r.group, r.id).map((c, i) => (
                <td class:list={["cmp-cell", { "cmp-ours": i > 0 }]}>
                  <span class={`cmp-mark cmp-${c}`} aria-hidden="true" />
                  <span class="sr-only">{word[c]}</span>
                  {!compact && COMPARE_FOOT[r.id]?.includes(i) && <sup class="cmp-foot" aria-hidden="true">*</sup>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>
