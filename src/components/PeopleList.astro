---
// Contributor cards with avatar, name, @login and commits; used on the home page and the tool pages.
import { Image } from "astro:assets";
import { dicts, type Lang } from "../i18n";
import type { Contributor } from "../lib/contributors";

interface Props {
  lang: Lang;
  people: Contributor[];
}
const { lang, people } = Astro.props;
const t = dicts[lang].contributors;
const nf = new Intl.NumberFormat(lang);
---

<ul class="people">
  {
    people.map((p) => (
      <li data-reveal>
        <a href={p.url} rel="noopener">
          <Image src={p.avatar} alt="" width={64} height={64} loading="lazy" />
          <span class="people-name">{p.name}</span>
          <span class="people-meta">
            @{p.login}
            {" · "}
            <span>{`${nf.format(p.commits)} ${t.commits}`}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
