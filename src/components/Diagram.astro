---
// Client ↔ standard server ↔ official client. Two layouts (wide / stacked) because
// a scaled-down wide SVG would make the labels unreadable on phones.
import icon from "../assets/mumcord-icon.png";
import { dicts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const t = dicts[Astro.props.lang].how;

const wide = {
  viewBox: "0 80 960 140",
  nodes: [
    { x: 1, y: 100, w: 270, title: t.you, sub: "Rust · Tauri · React", kind: "mumcord" },
    { x: 345, y: 90, w: 270, title: t.server, sub: t.serverSub, kind: "server" },
    { x: 689, y: 100, w: 270, title: t.friend, sub: "Mumble 1.4+", kind: "mumble" },
  ],
  control: ["M271 132 C 300 112, 316 112, 345 132", "M615 132 C 644 112, 660 112, 689 132"],
  voice: ["M271 168 C 300 188, 316 188, 345 168", "M615 168 C 644 188, 660 188, 689 168"],
};

const stacked = {
  viewBox: "0 0 360 560",
  nodes: [
    { x: 40, y: 10, w: 280, title: t.you, sub: "Rust · Tauri · React", kind: "mumcord" },
    { x: 20, y: 225, w: 320, title: t.server, sub: t.serverSub, kind: "server" },
    { x: 40, y: 450, w: 280, title: t.friend, sub: "Mumble 1.4+", kind: "mumble" },
  ],
  control: ["M150 110 C 130 150, 130 185, 150 225", "M150 335 C 130 375, 130 410, 150 450"],
  voice: ["M210 110 C 230 150, 230 185, 210 225", "M210 335 C 230 375, 230 410, 210 450"],
};

const layouts = [
  { cls: "dg-wide", ...wide },
  { cls: "dg-stacked", ...stacked },
];
const H = 100;
---

{
  layouts.map((l) => (
    <svg class={`dg ${l.cls}`} viewBox={l.viewBox} role="img" aria-label={`${t.you} ⇄ ${t.server} ⇄ ${t.friend}`}>
      {l.control.map((d, i) => (
        <path id={`${l.cls}-c${i}`} class="dg-path dg-control" d={d} />
      ))}
      {l.voice.map((d, i) => (
        <path id={`${l.cls}-v${i}`} class="dg-path dg-voice" d={d} />
      ))}
      {[...l.control.map((_, i) => `${l.cls}-c${i}`), ...l.voice.map((_, i) => `${l.cls}-v${i}`)].map((id, i) => (
        <g class={id.includes("-c") ? "dg-packet dg-packet-c" : "dg-packet dg-packet-v"}>
          <circle r="4.5">
            <animateMotion dur={`${2.2 + (i % 3) * 0.5}s`} repeatCount="indefinite" begin={`${i * 0.35}s`} keyPoints={i % 2 ? "1;0" : "0;1"} keyTimes="0;1" calcMode="linear">
              <mpath href={`#${id}`} />
            </animateMotion>
          </circle>
        </g>
      ))}
      {l.nodes.map((n) => (
        <g class={`dg-node dg-${n.kind}`}>
          <rect x={n.x} y={n.y} width={n.w} height={n.kind === "server" ? H + 20 : H} rx="20" />
          {n.kind === "mumcord" && <image href={icon.src} x={n.x + 18} y={n.y + 26} width="48" height="48" />}
          {n.kind === "server" && (
            <g class="dg-rack" transform={`translate(${n.x + 20} ${n.y + 32})`}>
              <rect width="44" height="14" rx="4" />
              <rect y="20" width="44" height="14" rx="4" />
              <rect y="40" width="44" height="14" rx="4" />
              <circle class="dg-led" cx="36" cy="7" r="2.5" />
              <circle class="dg-led" cx="36" cy="27" r="2.5" />
              <circle class="dg-led" cx="36" cy="47" r="2.5" />
            </g>
          )}
          {n.kind === "mumble" && (
            <g class="dg-people" transform={`translate(${n.x + 18} ${n.y + 26})`}>
              <circle cx="16" cy="14" r="9" />
              <circle cx="34" cy="14" r="9" />
              <path d="M2 46 C 2 30, 30 30, 30 46 Z M20 46 C 20 30, 48 30, 48 46 Z" />
            </g>
          )}
          <text x={n.x + 82} y={n.y + (n.kind === "server" ? 52 : 48)} class="dg-title">{n.title}</text>
          <text x={n.x + 82} y={n.y + (n.kind === "server" ? 74 : 70)} class="dg-sub">
            {n.sub.split(", ").map((line, i) => (
              <tspan x={n.x + 82} dy={i ? 18 : 0}>{line}</tspan>
            ))}
          </text>
        </g>
      ))}
    </svg>
  ))
}
<ul class="dg-legend">
  <li><span class="sw sw-control" aria-hidden="true"></span>{t.channelTls}</li>
  <li><span class="sw sw-voice" aria-hidden="true"></span>{t.channelUdp}</li>
</ul>
