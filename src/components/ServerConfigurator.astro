---
// Tick the features, get docker-compose.yml, .env and the setup commands. Runs in the browser only;
// without JavaScript the page shows the defaults the guide below explains.
import CopyButton from "./CopyButton.astro";
import { type Lang } from "../i18n";
import { guides } from "../lib/server-guide";
import { buildCompose, buildEnv, buildBotToml, botModules, buildCurlSetup, buildCurlSteps, buildSetup, STEP_IDS, DEFAULTS, BANDWIDTH, MUMBOT_MODULES_FROM, atLeast, type ServerOptions, type Quality } from "../lib/compose";
import { getMumbotVersion, getBotImageVersion } from "../lib/mumbot";
import { highlight, langOf } from "../lib/highlight";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = guides[lang];
const c = g.configurator;
// The files carry German or English comments; the other languages use English.
const fileLang = lang === "de" ? "de" : "en";
const released = await getMumbotVersion();
const mumbotVersion = await getBotImageVersion();
const d = { ...DEFAULTS[fileLang], mumbotVersion };
const site = Astro.site!.origin;
// All bots run as one Mumbot with modules, which comes with 0.2.0; until it is out, say so.
const modulesOut = atLeast(released, MUMBOT_MODULES_FROM);
const qualities = Object.keys(BANDWIDTH) as Quality[];
const steps = buildCurlSteps(fileLang, d, site);
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
const checks = Object.keys(c.options) as (keyof typeof c.options & keyof ServerOptions)[];
// Two ways to the same server: one command that does everything, or the files to create by hand.
const files = [
  { id: "setup", mode: "files", title: `1. ${c.setup}`, file: "Terminal", code: buildSetup(fileLang, d) },
  { id: "compose", mode: "files", title: "2. docker-compose.yml", file: "docker-compose.yml", code: buildCompose(fileLang, d) },
  { id: "env", mode: "files", title: "3. .env", file: ".env", code: buildEnv(fileLang, d) },
  { id: "bot", mode: "files", title: "4. bot.toml", file: "bot.toml", code: buildBotToml(fileLang, d) },
];
---

<section class="cfg" id="configurator" aria-labelledby="cfg-h" data-configurator data-lang={fileLang} data-site={site} data-mumbot={mumbotVersion}>
  <h2 id="cfg-h" class="cfg-title" data-reveal><span class="live-dot" aria-hidden="true"></span>{c.title}</h2>
  <p class="body" data-reveal set:html={md(c.intro)} />

  <div class="cfg-grid">
    <form class="cfg-form" data-reveal>
      <fieldset>
        <legend>{c.server}</legend>
        <label class="cfg-field">
          <span>{c.name}</span>
          <input name="name" type="text" maxlength="60" value={d.name} placeholder={d.name} autocomplete="off" />
        </label>
        <label class="cfg-field">
          <span>{c.welcome}</span>
          <input name="welcome" type="text" maxlength="200" value={d.welcome} autocomplete="off" />
        </label>
        <label class="cfg-field">
          <span>{c.users}</span>
          <input name="users" type="number" min="1" max="10000" value={d.users} inputmode="numeric" />
        </label>
      </fieldset>
      <fieldset>
        <legend>{c.features}</legend>
        {
          checks.map((k) => (
            <label class="cfg-check">
              <input name={k} type="checkbox" checked={d[k] === true} />
              <span class="cfg-check-text">
                <b>{c.options[k][0]}</b>
                <span>{c.options[k][1]}</span>
              </span>
            </label>
          ))
        }
        {!modulesOut && <p class="cfg-hint">{c.needsMumbot}</p>}
      </fieldset>
      <fieldset>
        <legend>{c.quality.label}</legend>
        <div class="cfg-seg" role="radiogroup" aria-label={c.quality.label}>
          {
            qualities.map((k) => (
              <label>
                <input type="radio" name="quality" value={k} checked={d.quality === k} />
                <span>
                  <b>{c.quality[k]}</b>
                  <small>{BANDWIDTH[k] / 1000} kbit/s</small>
                </span>
              </label>
            ))
          }
        </div>
        <p class="cfg-hint">{c.quality.hint}</p>
      </fieldset>
      <fieldset>
        <legend>{c.advanced}</legend>
        <label class="cfg-field">
          <span>{c.pluginLimit}</span>
          <input name="pluginLimit" type="number" min="1" max="1000" value={d.pluginLimit} placeholder={String(d.pluginLimit)} inputmode="numeric" />
        </label>
        <label class="cfg-field">
          <span>{c.pluginBurst}</span>
          <input name="pluginBurst" type="number" min="1" max="1000" value={d.pluginBurst} placeholder={String(d.pluginBurst)} inputmode="numeric" />
        </label>
        <p class="cfg-hint">{c.pluginHint}</p>
      </fieldset>
    </form>

    <div class="cfg-out">
      <div class="cfg-seg cfg-mode" role="radiogroup" aria-label={c.title}>
        <label>
          <input type="radio" name="mode" value="command" checked />
          <span><b>{c.modeCommand}</b></span>
        </label>
        <label>
          <input type="radio" name="mode" value="files" />
          <span><b>{c.modeFiles}</b></span>
        </label>
      </div>
      <ol class="cfg-steps" data-mode="command">
        {
          STEP_IDS.map((id, i) => (
            <li data-step={id} hidden={!steps[id]}>
              <figure class="code">
                <figcaption>
                  <span>
                    <b class="cfg-step-num">{i + 1}</b> {c.steps[id]}
                  </span>
                  <CopyButton label={g.copy} copied={g.copied} class="is-quiet" />
                </figcaption>
                <pre><code data-out={`step-${id}`} set:html={highlight(steps[id], "shell")} /></pre>
              </figure>
            </li>
          ))
        }
      </ol>
      <p class="cfg-copy-all" data-mode="command">
        <CopyButton text={buildCurlSetup(fileLang, d, site)} label={c.copyAll} copied={g.copied} />
      </p>
      {
        files.map((f) => (
          <figure class="code" data-mode={f.mode} hidden>
            <figcaption>
              <span>{f.title}</span>
              <span class="cfg-actions">
                {f.mode === "files" && f.id !== "setup" && (
                  <button type="button" class="copy-btn is-quiet" data-download={f.file}>
                    {c.download}
                  </button>
                )}
                <CopyButton label={g.copy} copied={g.copied} class="is-quiet" />
              </span>
            </figcaption>
            <pre><code data-out={f.id} data-lang={langOf(f.file)} set:html={highlight(f.code, langOf(f.file))} /></pre>
          </figure>
        ))
      }
      <p class="cfg-secrets" data-mode="files" hidden>
        <span set:html={md(c.secrets)} />
        <button type="button" class="text-link" data-regenerate>{c.regenerate}</button>
      </p>
      <div class="cfg-notes" data-reveal>
        <h3>{c.after}</h3>
        <ul>
          <li set:html={md(c.notes.ports)} />
          <li data-note="relay" hidden set:html={md(c.notes.portsRelay)} />
          <li data-note="relay" hidden set:html={md(c.notes.relay)} />
          <li data-note="webhook" hidden set:html={md(c.notes.webhook)} />
          <li data-note="music" hidden set:html={md(c.notes.music)} />
          <li data-note="history" hidden set:html={md(c.notes.history)} />
          <li set:html={md(c.notes.more)} />
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { highlight, type CodeLang } from "../lib/highlight";
  import { buildCompose, buildEnv, buildBotToml, botModules, buildCurlSetup, buildCurlSteps, buildSetup, STEP_IDS, randomSecret, type CommentLang, type ServerOptions, type Secrets, type Quality } from "../lib/compose";

  for (const root of document.querySelectorAll<HTMLElement>("[data-configurator]")) {
    const lang = root.dataset.lang as CommentLang;
    const form = root.querySelector("form")!;
    const out = (id: string) => root.querySelector<HTMLElement>(`[data-out="${id}"]`)!;
    const fresh = (): Secrets => ({ superuser: randomSecret(), server: randomSecret(16), peer: randomSecret(48), webhookKey: randomSecret(48), musicKey: randomSecret(48) });
    let secrets = fresh();

    const read = (): ServerOptions => {
      const v = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
      // Music and history are only in the form once their Mumbot release is out.
      const maybe = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.checked ?? false;
      return {
        name: v("name").value.trim() || v("name").placeholder,
        welcome: v("welcome").value.trim(),
        users: Number(v("users").value),
        password: v("password").checked,
        bigImages: v("bigImages").checked,
        longText: v("longText").checked,
        relay: v("relay").checked,
        webhook: v("webhook").checked,
        music: maybe("music"),
        history: maybe("history"),
        quality: ((form.elements.namedItem("quality") as RadioNodeList).value || "standard") as Quality,
        mumbotVersion: root.dataset.mumbot!,
        pluginLimit: Number(v("pluginLimit").value),
        pluginBurst: Number(v("pluginBurst").value),
      };
    };

    const render = () => {
      const o = read();
      const site = root.dataset.site!;
      const steps = buildCurlSteps(lang, o, site);
      for (const id of STEP_IDS) {
        out(`step-${id}`).innerHTML = highlight(steps[id], "shell");
        root.querySelector<HTMLElement>(`[data-step="${id}"]`)!.hidden = !steps[id];
      }
      root.querySelector<HTMLElement>(".cfg-copy-all [data-copy]")!.dataset.copy = buildCurlSetup(lang, o, site);
      const put = (id: string, code: string) => (out(id).innerHTML = highlight(code, out(id).dataset.lang as CodeLang));
      put("setup", buildSetup(lang, o));
      put("compose", buildCompose(lang, o));
      put("env", buildEnv(lang, o, secrets));
      put("bot", buildBotToml(lang, o, { webhook: secrets.webhookKey, music: secrets.musicKey }));
      out("bot").closest("figure")!.dataset.empty = botModules(o).length ? "" : "1";
      for (const n of root.querySelectorAll<HTMLElement>("[data-note]")) n.hidden = !o[n.dataset.note as "relay" | "webhook" | "music" | "history"];
    };

    form.addEventListener("input", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    root.querySelector("[data-regenerate]")!.addEventListener("click", () => {
      secrets = fresh();
      render();
    });
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-download]"))
      b.addEventListener("click", () => {
        const text = b.closest("figure")!.querySelector("code")!.textContent ?? "";
        const a = document.createElement("a");
        // octet-stream, so the browser keeps the name instead of adding ".txt".
        a.href = URL.createObjectURL(new Blob([text], { type: "application/octet-stream" }));
        a.download = b.dataset.download!;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      });
    // Show either the one command or the files to create by hand.
    for (const r of root.querySelectorAll<HTMLInputElement>('input[name="mode"]'))
      r.addEventListener("change", () => {
        for (const el of root.querySelectorAll<HTMLElement>("[data-mode]")) el.hidden = el.dataset.mode !== r.value;
      });
    render();
  }
</script>
