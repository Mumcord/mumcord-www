---
import { pluginsPage, PLUGIN_IDS, type PluginId } from "../lib/plugins";
import "../styles/plugins.css";
import plgPoll from "../assets/plugins/poll.png";
import plgDice from "../assets/plugins/dice.png";
import plgEcho from "../assets/plugins/echolings.png";
import plgMusic from "../assets/plugins/mumbot-music.png";
import plgEve from "../assets/plugins/eve-fit.png";
import plgSkyloom from "../assets/plugins/skyloom.png";
import { Picture, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import mainDark from "../assets/shots/main-dark.png";
import icon from "../assets/mumcord-icon.png";
import Diagram from "./Diagram.astro";
import Mimo from "./Mimo.astro";
import { wavePath } from "../lib/wave";

import { dicts, routes, type Lang } from "../i18n";
import { REPO_URL, getLatestRelease, getReleases } from "../lib/release";
import { tour, allThemes, THEME_COLOR_KEYS } from "../lib/themes";
import { roadmapPage } from "../lib/roadmap";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const release = await getLatestRelease();

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const shot = (name: string) => shots[`../assets/shots/${name}.png`].default;

const noisy = wavePath({ seed: 7, width: 600, height: 80, points: 220, noise: 0.85, speech: 0.5 });
const clean = wavePath({ seed: 7, width: 600, height: 80, points: 220, noise: 0.04, speech: 0.9 });
const sp = t.spotlight5;
const s5plugins = [plgPoll, plgDice, plgEcho, plgMusic, plgEve];
const pl = pluginsPage[lang];
const hpIcons: Partial<Record<PluginId, ImageMetadata>> = { poll: plgPoll, dice: plgDice, echolings: plgEcho, "mumbot-music": plgMusic, "eve-fit": plgEve };
// The 0.5.0 tiles: small drawn demos, no screenshots; names stay the same in every language.
// The epic chips take each epic's status from the roadmap; an epic is done once its release is out.
const released = new Set((await getReleases()).map((r) => r.version));
const epicStatus = roadmapPage.en.epics.map((e) => (e.version && released.has(e.version) ? "done" : e.status));
const nx = t.roadmap.next;
const tt = t.themesTour;
const tourColors = tour.map((x) => allThemes.find((th) => th.id === x.theme)?.[x.mode]);
import Arrow from "./Arrow.astro";
---

<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
  <div class="hero-copy">
    <p class="kicker" data-reveal><span class="live-dot" aria-hidden="true"></span>{release && `v${release.version} · `}{t.hero.kicker}</p>
    <h1 id="hero-title" class="hero-title">
      <span class="line" data-reveal>{t.hero.titleA}</span>
      <span class="line line-b" data-reveal>
        <span class="hl">
          {t.hero.titleB}
          <svg class="squiggle" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 14 C 30 2, 50 22, 80 12 S 130 2, 160 12 S 210 22, 240 12 S 290 2, 320 12 S 370 22, 398 10" />
          </svg>
        </span>
      </span>
    </h1>
    <p class="hero-lead" data-reveal>{t.hero.lead}</p>
    <div class="hero-cta" data-reveal>
      <a class="btn btn-primary" href={routes.download[lang]}>
        {t.hero.ctaDownload}
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3v11m0 0-4.5-4.5M10 14l4.5-4.5M4 17h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn-ghost" href={REPO_URL} rel="noopener">{t.hero.ctaSource}</a>
      <span class="hero-meta">{t.hero.meta}</span>
    </div>
  </div>

  <div class="hero-stage">
    <figure class="window">
      <div class="window-bar" aria-hidden="true">
        <Image src={icon} alt="" width={18} height={18} />
        <span>Mumcord — Night Owls</span>
        <i></i><i></i><i></i>
      </div>
      <div class="window-body">
        <Picture
          src={mainDark}
          formats={["avif", "webp"]}
          widths={[720, 1200, 1800, 2880]}
          sizes="(min-width: 1000px) 680px, 94vw"
          alt={t.hero.shotAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
    <Mimo id="hero" role="hero" class="mimo-hero">
      <span class="mimo-say" aria-hidden="true"><b>Mimo</b> {t.hero.talking}<span class="mimo-bars"><i></i><i></i><i></i><i></i></span></span>
    </Mimo>
  </div>
  </div>
</section>

<!-- What only Mumcord does, as small drawn mockups -->
<section class="section unique" id="neu" aria-labelledby="unique-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.unique.label}</p>
      <h2 id="unique-title" class="h2" data-reveal>{t.unique.title}</h2>
      <p class="body" data-reveal>{t.unique.body}</p>
    </div>
    <div class="uq-grid">
      <article class="card card-follow" data-reveal>
        <div class="demo demo-follow" aria-hidden="true" data-follow-demo>
          <div class="ch"><span class="hash">#</span>Lobby<span class="ch-count">5</span></div>
          <div class="ch is-followed">
            <span class="hash">#</span>{t.features.followDemo.channel}
            <svg class="eye" viewBox="0 0 24 24" width="15" height="15"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
            <span class="badge" data-badge>3</span>
          </div>
          <div class="ch"><span class="hash">#</span>Squad A<span class="ch-count">2</span></div>
          <div class="ch dim"><span class="hash">#</span>AFK</div>
          <div class="toast" data-toast><b>{t.features.followDemo.unread}</b> {t.features.followDemo.message}</div>
        </div>
        <h3>{t.features.items[0].title}</h3>
        <p>{t.unique.follow}</p>
      </article>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-noise">
            <div class="mm-noise-row">
              <span>{t.features.noise.before}</span>
              <svg viewBox="0 0 600 80" preserveAspectRatio="none"><path d={noisy} /></svg>
            </div>
            <div class="mm-noise-row is-clean">
              <span>{t.features.noise.after}</span>
              <svg viewBox="0 0 600 80" preserveAspectRatio="none"><path d={clean} /></svg>
            </div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{t.features.items[1].title}</h3>
          <p>{t.unique.audio}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <ul class="mm-dm">
            <li class="is-on"><i style="--c: var(--pink)">P</i><span><b>Priya</b><em>Night Owls</em></span><small>Bist du gleich da?</small></li>
            <li><i style="--c: var(--violet)">J</i><span><b>Jonas</b><em>LAN Party</em></span><small>gg!</small></li>
            <li><i style="--c: var(--live)">L</i><span><b>Leo</b><em>Raid Server</em></span><small>Link zum Build</small></li>
          </ul>
        </div>
        <div class="s5-text">
          <h3>{t.unique.tiles.dm.title}</h3>
          <p>{t.unique.tiles.dm.body}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-embed">
            <div class="mm-video"><span class="mm-play"></span><b>YouTube</b></div>
            <div class="mm-side">
              <div class="mm-img"></div>
              <div class="mm-audio"><span class="mm-play mm-play-s"></span><i></i></div>
            </div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{t.unique.tiles.embeds.title}</h3>
          <p>{t.unique.tiles.embeds.body}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-file">
            <div class="mm-msg"><i style="--c: var(--peach)">A</i><b>Alice</b><em>21:04</em></div>
            <div class="mm-file-card">
              <span class="mm-file-ico">PDF</span>
              <span class="mm-file-name"><b>game-night-slides.pdf</b><em>18,4 MB</em></span>
              <span class="mm-file-dl"><Arrow dir="down" /></span>
            </div>
            <div class="mm-file-foot"><span class="mm-ok">✓ SHA-256</span><span class="mm-ip">IP hidden</span></div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{nx.tiles.files.title}</h3>
          <p>{nx.tiles.files.body}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-share">
            <div class="mm-share-screen">
              <span class="mm-live">LIVE</span>
              <span class="mm-share-q">4K · 60 fps</span>
              <i></i><i></i><i></i>
            </div>
            <div class="mm-viewers"><i style="--c: var(--peach)"></i><i style="--c: var(--violet)"></i><i style="--c: var(--live)"></i><i style="--c: var(--pink)"></i><span>+20</span></div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{nx.tiles.share.title}</h3>
          <p>{nx.tiles.share.body}</p>
        </div>
      </a>
      <a class="nx-tile nx-camera" href={routes.features[lang]} data-reveal>
        <div class="s5-demo nx-demo" aria-hidden="true">
          <div class="d7-grid">
            <span style="--c: var(--peach); --h: 28"><i /><b>Maya</b></span>
            <span class="is-talk" style="--c: var(--violet); --h: 250"><i /><b>Jonas</b></span>
            <span style="--c: var(--live); --h: 160"><i /><b>Priya</b></span>
            <span style="--c: var(--pink); --h: 330"><i /><b>Leo</b><em>LIVE</em></span>
          </div>
        </div>
        <div class="s5-text">
          <h3>{nx.tiles.camera.title}</h3>
          <p>{nx.tiles.camera.body}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.features[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-watch">
            <div class="mm-screen"><span class="mm-play"></span><span class="mm-sync">sync</span></div>
            <div class="mm-bar"><i></i></div>
            <div class="mm-viewers"><i style="--c: var(--peach)"></i><i style="--c: var(--violet)"></i><i style="--c: var(--live)"></i><i style="--c: var(--pink)"></i><span>+3</span></div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{t.unique.tiles.watch.title}</h3>
          <p>{t.unique.tiles.watch.body}</p>
        </div>
      </a>
      <a class="s5-tile s5-plugins" href={routes.plugins[lang]} data-reveal>
        <div class="s5-demo" aria-hidden="true">
          <div class="d5-plugins">
            {s5plugins.map((ic, i) => <span style={`--i: ${i}`}><Image src={ic} alt="" width={64} height={64} /></span>)}
          </div>
          <div class="d5-poll">
            <i style="--w: 50%" /><i style="--w: 100%" /><i style="--w: 25%" />
          </div>
        </div>
        <div class="s5-text">
          <h3>{t.unique.tiles.plugins.title}</h3>
          <p>{t.unique.tiles.plugins.body}</p>
        </div>
      </a>
      <a class="s5-tile mm-tile" href={routes.mumbot[lang]} data-reveal>
        <div class="s5-demo mm-demo" aria-hidden="true">
          <div class="mm-bot">
            <div class="mm-bot-head"><i>M</i><b>Mumbot</b><span>BOT</span></div>
            <code>/play lofi beats</code>
            <div class="mm-now"><span class="mm-play mm-play-s"></span><span>Lofi Beats · 2:14</span><i></i></div>
          </div>
        </div>
        <div class="s5-text">
          <h3>{t.unique.tiles.bots.title}</h3>
          <p>{t.unique.tiles.bots.body}</p>
        </div>
      </a>
      <a class="s5-tile s5-relay" href={routes.features[lang]} data-reveal>
        <div class="s5-demo" aria-hidden="true">
                <svg class="d5-relay" viewBox="0 0 320 120" aria-hidden="true">
                  <path class="d5-direct" d="M60 92 H260" />
                  <path class="d5-arc" d="M60 92 C60 30 110 24 160 24 C210 24 260 30 260 92" />
                  <circle cx="60" cy="92" r="16" fill="var(--peach)" />
                  <circle cx="260" cy="92" r="16" fill="var(--violet)" />
                  <circle cx="160" cy="24" r="20" fill="#f6f0e8" />
                  <rect x="151" y="21" width="18" height="13" rx="3" fill="#1d0f5c" />
                  <path d="M155 21 v-4 a5 5 0 0 1 10 0 v4" fill="none" stroke="#1d0f5c" stroke-width="3" />
                </svg>
                <span class="d5-pill">IP hidden</span>
        </div>
        <div class="s5-text">
          <h3>{sp.tiles.relay.title}</h3>
          <p>{sp.tiles.relay.body}</p>
        </div>
      </a>
      <a class="s5-tile s5-notifications" href={routes.features[lang]} data-reveal>
        <div class="s5-demo" aria-hidden="true">
                <div class="d5-bell"><svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15ZM10 20a2 2 0 0 0 4 0" /></svg><b>3</b></div>
                <ul class="d5-notes">
                  <li><i style="--c: var(--pink)" /><span><b>Priya</b> @Maya</span><em>Raid Night</em></li>
                  <li><i style="--c: var(--violet)" /><span><b>Jonas</b> ↩ 20:00?</span><em>LAN Party</em></li>
                  <li><i style="--c: var(--live)" /><span><b>Leo</b> → #lobby</span><em>Night Owls</em></li>
                </ul>
        </div>
        <div class="s5-text">
          <h3>{sp.tiles.notifications.title}</h3>
          <p>{sp.tiles.notifications.body}</p>
        </div>
      </a>
    </div>
    <p class="s5-more" data-reveal>
      <a class="btn btn-small" href={routes.features[lang]}>{sp.features}</a>
      <a class="text-link" href={routes.changelog[lang]}>{sp.changelog}<Arrow /></a>
    </p>
  </div>
</section>

<!-- Themes: a stack of screenshots, flipped through while scrolling -->
<section class="section hp-plugins" id="plugins" aria-labelledby="hp-plugins-title">
  <div class="wrap">
    <div class="hp-plugins-top">
      <div>
        <p class="plg-badge" data-reveal><span class="live-dot" aria-hidden="true"></span>{pl.badge}</p>
        <h2 id="hp-plugins-title" class="plg-title hp-plugins-title" data-reveal>{pl.title}</h2>
        <p class="body" data-reveal>{pl.intro}</p>
        <ul class="plg-pills" data-reveal>{pl.pills.map((x) => <li>{x}</li>)}</ul>
        <p class="plg-cta" data-reveal>
          <a class="btn btn-primary btn-glow" href={routes.plugins[lang]}>{pl.ctaPlugins}</a>
          <a class="btn btn-ghost" href={`${routes.plugins[lang]}#develop`}>{pl.ctaDev}</a>
        </p>
      </div>
      <div class="plg-orbit" aria-hidden="true" data-reveal style={`--n:${s5plugins.length}`}>
        <div class="plg-ring plg-ring-1"></div>
        <div class="plg-ring plg-ring-2"></div>
        <div class="plg-core"><Image src={icon} alt="" width={96} height={96} /></div>
        {s5plugins.map((ic, i) => (
          <div class="plg-sat" style={`--i:${i}`}>
            <Image src={ic} alt="" width={88} height={88} />
          </div>
        ))}
      </div>
    </div>
    <ul class="hp-plugins-list">
      {PLUGIN_IDS.map((id, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={`${routes.plugins[lang]}#plugins`}>
            {hpIcons[id] ? (
              <Image src={hpIcons[id]!} alt="" width={56} height={56} />
            ) : (
              <svg class="plg-icon-eve" viewBox="0 0 56 56" aria-hidden="true">
                <path d="M28 6 47 17v22L28 50 9 39V17L28 6Z" />
                <path d="M28 15 39 21.5v13L28 41l-11-6.5v-13L28 15Z" />
                <path d="M28 15v26M17 21.5l22 13M39 21.5l-22 13" />
              </svg>
            )}
            <b>{pl.plugins[id].name}</b>
            <span set:html={pl.plugins[id].tagline.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/`([^`]+)`/g, "<code>$1</code>")} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="th-tour" aria-labelledby="th-tour-title" data-theme-tour style={`--n: ${tour.length}`}>
  <div class="th-tour-sticky">
    <div class="wrap th-tour-inner">
      <div class="th-tour-copy">
        <p class="label">{tt.label}</p>
        <h2 id="th-tour-title" class="h2">{tt.title}</h2>
        <p class="body">{tt.body}</p>
        <ol class="th-tour-names" aria-hidden="true">
          {
            tour.map((x, i) => (
              <li data-tour-name={i}>
                <b>{x.name}</b>
                {tourColors[i] && (
                  <span class="th-tour-swatches">
                    {THEME_COLOR_KEYS.map((k) => (
                      <i style={`background: ${tourColors[i]![k]}`} />
                    ))}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
        <p class="th-tour-dots" aria-hidden="true">{tour.map((_, i) => <span data-tour-dot={i} />)}</p>
        <a class="btn btn-small btn-glow" href={routes.themes[lang]}>{tt.cta}<Arrow /></a>
      </div>
      <div class="th-stack" aria-hidden="true">
        {
          tour.map((x, i) => (
            <figure class="th-stack-card" style={`--i: ${i}; z-index: ${tour.length - i}`}>
              <Picture src={shot(x.shot)} formats={["avif", "webp"]} widths={[640, 1100, 1600]} sizes="(min-width: 980px) 640px, 90vw" alt="" loading={i < 2 ? "eager" : "lazy"} />
              <figcaption>{x.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>


<!-- How it works -->
<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.how.label}</p>
      <h2 id="how-title" class="h2" data-reveal>{t.how.title}</h2>
      <p class="body" data-reveal>{t.how.body}</p>
    </div>

    <div class="diagram" data-reveal>
      <Diagram lang={lang} />
    </div>

    <div class="how-bottom">
      <div class="link-demo" data-reveal>
        <div class="addressbar" aria-hidden="true">
          <span class="lock">⟶</span>
          <span class="typed" data-type="mumble://voice.night-owls.example/Gaming/Squad%20A"></span><span class="caret"></span>
        </div>
        <h3>{t.how.linkTitle}</h3>
        <p>{t.how.linkBody}</p>
      </div>
      <dl class="facts">
        {
          t.how.facts.map((f) => (
            <div data-reveal>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <a class="server-cta" href={`${routes.server[lang]}#configurator`} data-reveal>
      <span class="server-cta-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 7h9m4 0h3M4 17h3m4 0h9M13 7a2 2 0 1 0 4 0a2 2 0 1 0-4 0M7 17a2 2 0 1 0 4 0a2 2 0 1 0-4 0" /></svg>
      </span>
      <span class="server-cta-text">
        <b>{t.serverCta.title}</b>
        <span>{t.serverCta.body}</span>
      </span>
      <span class="btn btn-small">{t.serverCta.button}<Arrow /></span>
    </a>
  </div>
</section>


<!-- Roadmap -->
<!-- What comes next: 0.8.0 as drawn demos, then every epic as a chip -->
<section class="section roadmap nx" id="roadmap" aria-labelledby="roadmap-title">
  <div class="wrap">
    <div class="section-head nx-head">
      <p class="label" data-reveal>{t.roadmap.label} · 0.8.0</p>
      <h2 id="roadmap-title" class="h2" data-reveal>{nx.after.title}</h2>
      <p class="body" data-reveal>{nx.after.body}</p>
      <span class="nx-ver" aria-hidden="true">0.8</span>
    </div>

    <div class="nx-after">
      <div class="nx-after-grid">
      <a class="nx-tile nx-acl nx-small" href={`${routes.roadmap[lang]}#epic-4`} data-reveal>
        <div class="s5-demo nx-demo" aria-hidden="true">
          <table class="d7-acl">
            <tr><th /><th>@admin</th><th>@all</th></tr>
            <tr><td>Enter</td><td class="y">✓</td><td class="y">✓</td></tr>
            <tr class="is-win"><td>Speak</td><td class="y">✓</td><td class="n">✕</td></tr>
            <tr><td>Move</td><td class="y">✓</td><td class="n">✕</td></tr>
            <tr><td>Ban</td><td class="y">✓</td><td class="n">✕</td></tr>
          </table>
        </div>
        <div class="s5-text">
          <h3>{nx.after.tiles.acl.title}</h3>
          <p>{nx.after.tiles.acl.body}</p>
        </div>
      </a>
      <a class="nx-tile nx-channels nx-small" href={`${routes.roadmap[lang]}#epic-4`} data-reveal>
        <div class="s5-demo nx-demo" aria-hidden="true">
          <ul class="d7-tree">
            <li># Lobby</li>
            <li class="is-drag"># Raid <span>✎</span></li>
            <li class="d7-drop-line" />
            <li># Officers <span>🔒</span></li>
