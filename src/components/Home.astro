---
import { Picture, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import mainDark from "../assets/shots/main-dark.png";
import icon from "../assets/mumcord-icon.png";
import Diagram from "./Diagram.astro";
import Download from "./Download.astro";
import { dicts, routes, type Lang } from "../i18n";
import { REPO_URL, getLatestRelease, getReleases } from "../lib/release";
import { wavePath } from "../lib/wave";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const release = await getLatestRelease();

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const shot = (name: string) => shots[`../assets/shots/${name}.png`].default;

const noisy = wavePath({ seed: 7, width: 600, height: 80, points: 220, noise: 0.85, speech: 0.5 });
const clean = wavePath({ seed: 7, width: 600, height: 80, points: 220, noise: 0.04, speech: 0.9 });
const fingerprint = "4F:9A:C1:07:3B:E2:58:D0:1A:7C:96:E4:2F:B3:0D:61";
const [showcase, rest] = [t.features.items.slice(0, 3), t.features.items.slice(3)];
const sp = t.spotlight;
const spotlightOut = (await getReleases()).some((r) => r.version === "0.4.0");
// Demo data for the 0.4.0 tiles; names stay the same in every language.
const servers = [
  { tag: "TF", hue: "var(--peach)", talking: true },
  { tag: "RN", hue: "var(--pink)", unread: 3 },
  { tag: "LP", hue: "var(--violet)", unread: 12 },
  { tag: "EU", hue: "var(--live)" },
  { tag: "+", hue: "transparent" },
];
const toasts = [
  { server: "Raid Night", channel: "#raid", who: "Priya", text: "@Maya in 5?" },
  { server: "LAN Party", channel: "#lobby", who: "Jonas", text: "Pizza ist da 🍕" },
];
const themes = [
  "linear-gradient(135deg, #1d1650, #ff6fa8 60%, #ffb08a)",
  "linear-gradient(135deg, #0f2a2a, #3ee39e 60%, #c9ffe9)",
  "linear-gradient(135deg, #1a1a1a, #6b8cff 60%, #d6e0ff)",
  "linear-gradient(135deg, #2b1608, #ff9f43 60%, #ffe0b8)",
  "linear-gradient(135deg, #f6f0e8, #9b7bff 60%, #2a1f5c)",
  "linear-gradient(135deg, #10202f, #4fc3f7 60%, #e1f5fe)",
];
const party = ["Maya", "Priya", "Jonas"];
---

<!-- Hero -->
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-copy">
    <p class="kicker" data-reveal><span class="live-dot" aria-hidden="true"></span>{release && `v${release.version} · `}{t.hero.kicker}</p>
    <h1 id="hero-title" class="hero-title">
      <span class="line" data-reveal>{t.hero.titleA}</span>
      <span class="line line-b" data-reveal>
        <span class="hl">
          {t.hero.titleB}
          <svg class="squiggle" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 14 C 30 2, 50 22, 80 12 S 130 2, 160 12 S 210 22, 240 12 S 290 2, 320 12 S 370 22, 398 10" />
          </svg>
        </span>
      </span>
    </h1>
    <p class="hero-lead" data-reveal>{t.hero.lead}</p>
    <div class="hero-cta" data-reveal>
      <a class="btn btn-primary" href="#download">
        {t.hero.ctaDownload}
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M10 3v11m0 0-4.5-4.5M10 14l4.5-4.5M4 17h12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn-ghost" href={REPO_URL} rel="noopener">{t.hero.ctaSource}</a>
      <span class="hero-meta">{t.hero.meta}</span>
    </div>
  </div>

  <div class="wrap-wide hero-stage">
    <figure class="window" data-tilt>
      <div class="window-bar" aria-hidden="true">
        <Image src={icon} alt="" width={18} height={18} />
        <span>Mumcord — Night Owls</span>
        <i></i><i></i><i></i>
      </div>
      <div class="window-body">
        <Picture
          src={mainDark}
          formats={["avif", "webp"]}
          widths={[720, 1200, 1800, 2880]}
          sizes="(min-width: 1320px) 1240px, 94vw"
          alt={t.hero.shotAlt}
          loading="eager"
          fetchpriority="high"
        />
        <span class="ring" style="--x: 9.15%; --y: 29.4%; --s: 2.2%" aria-hidden="true"></span>
        <span class="ring" style="--x: 86.15%; --y: 15.55%; --s: 2.75%" aria-hidden="true"></span>
        <span class="speaker-tag" aria-hidden="true">
          <b>Maya</b>
          {t.hero.talking}
          <span class="mini-bars"><i></i><i></i><i></i><i></i><i></i></span>
        </span>
      </div>
    </figure>
  </div>
</section>

<!-- Ticker -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => t.ticker.map((item) => <span>{item}</span>))}
  </div>
</div>

<!-- Push-to-talk -->
<section class="section ptt" id="ptt" aria-labelledby="ptt-title" data-ptt>
  <div class="wrap split">
    <div>
      <p class="label" data-reveal>{t.ptt.label}</p>
      <h2 id="ptt-title" class="h2" data-reveal>{t.ptt.title}</h2>
      <p class="body" data-reveal>{t.ptt.body}</p>
      <p class="fine" data-reveal>{t.ptt.note}</p>
    </div>
    <div class="ptt-demo" data-reveal>
      <div class="ptt-status" role="status" aria-live="polite">
        <span class="ptt-dot" aria-hidden="true"></span>
        <span data-ptt-idle>{t.ptt.idle}</span>
        <span data-ptt-live hidden>{t.ptt.live}</span>
      </div>
      <div class="ptt-wave" aria-hidden="true">
        {Array.from({ length: 36 }, () => <i></i>)}
      </div>
      <button class="keycap" type="button" data-ptt-key aria-describedby="ptt-hint">
        <span class="keycap-top">{t.ptt.keyLabel}</span>
      </button>
      <p class="ptt-hint" id="ptt-hint">{t.ptt.hint}</p>
    </div>
  </div>
</section>

<!-- Spotlight: what 0.4.0 brings -->
<section class="section spotlight" id="neu" aria-labelledby="spotlight-title">
  <div class="spotlight-glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head spotlight-head">
      <p class="label" data-reveal>{spotlightOut ? sp.label : sp.labelSoon}</p>
      <h2 id="spotlight-title" class="h2" data-reveal>{sp.title}</h2>
      <p class="body" data-reveal>{sp.body}</p>
    </div>

    <div class="sp-bento">
      <a class="sp-tile sp-servers" href={routes.features[lang]} data-reveal data-spot>
        <div class="sp-servers-demo" aria-hidden="true">
          <ul class="sp-rail">
            {
              servers.map((x) => (
                <li class:list={[{ "is-talking": x.talking, "is-add": x.tag === "+" }]} style={`--c: ${x.hue}`}>
                  {x.tag}
                  {x.unread && <b>{x.unread}</b>}
                </li>
              ))
            }
          </ul>
          <div class="sp-toasts">
            <p class="sp-voice-here"><span class="live-dot"></span>Tiffoyn · #gaming · {sp.servers.talking}</p>
            {
              toasts.map((x) => (
                <p class="sp-toast">
                  <span class="sp-toast-head">{x.server} · {x.channel}</span>
                  <span><strong>{x.who}</strong> {x.text}</span>
                </p>
              ))
            }
          </div>
        </div>
        <div class="sp-text">
          <h3>{sp.servers.title}</h3>
          <p>{sp.servers.body}</p>
        </div>
      </a>

      <div class="sp-tile sp-themes" data-reveal data-spot>
        <div class="sp-swatches" aria-hidden="true">
          {themes.map((bg) => <span style={`--g: ${bg}`} />)}
        </div>
        <p class="sp-mode" aria-hidden="true"><span>{sp.themes.light}</span><span class="is-on">{sp.themes.dark}</span></p>
        <div class="sp-text">
          <h3>{sp.themes.title}</h3>
          <p>{sp.themes.body}</p>
        </div>
      </div>

      <a class="sp-tile sp-win" href={routes.games[lang]} data-reveal data-spot>
        <div class="sp-game" aria-hidden="true">
          <ul class="sp-ov">
            {party.map((n, i) => <li class:list={[{ "is-talking": i === 0 }]}>{n}</li>)}
          </ul>
        </div>
        <div class="sp-text">
          <h3>{sp.overlay.title}</h3>
          <p>{sp.overlay.body}</p>
          <span class="sp-more">{sp.games} →</span>
        </div>
      </a>

      <div class="sp-tile sp-together" data-reveal data-spot>
        <div class="sp-widget" aria-hidden="true">
          <p class="sp-widget-bar">
            <span>{sp.together.party}</span>
            <span class="sp-avatars">{party.map((n) => <i>{n[0]}</i>)}</span>
            <span class="sp-widget-btns"><i></i><i></i></span>
          </p>
          <div class="sp-video"><span class="sp-play"></span><span class="sp-progress"></span></div>
          <p class="sp-next">{sp.together.next}: Lofi Beats · 24/7</p>
        </div>
        <div class="sp-text">
          <p class="sp-pills"><span class="pill pill-beta">{sp.beta}</span></p>
          <h3>{sp.together.title}</h3>
          <p>{sp.together.body}</p>
        </div>
      </div>

      <div class="sp-tile sp-replies" data-reveal data-spot>
        <div class="sp-chat" aria-hidden="true">
          <p class="sp-msg"><i style="--c: var(--pink)">P</i><span><strong>Priya</strong>{sp.replies.quote}</span></p>
          <p class="sp-msg sp-reply"><i style="--c: var(--peach)">M</i><span><em>↪ Priya: {sp.replies.quote}</em><strong>Maya</strong>{sp.replies.reply}</span></p>
        </div>
        <div class="sp-text">
          <h3>{sp.replies.title}</h3>
          <p>{sp.replies.body}</p>
        </div>
      </div>
    </div>

    <p class="sp-actions" data-reveal>
      <a class="btn btn-small btn-glow" href={routes.features[lang]}>{t.features.all}</a>
      <a class="text-link" href={routes.changelog[lang]}>{sp.changelog} →</a>
    </p>
  </div>
</section>

<!-- Features -->
<section class="section features" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.features.label}</p>
      <h2 id="features-title" class="h2" data-reveal>{t.features.title}</h2>
      <p class="body" data-reveal>{t.features.intro}</p>
    </div>

    <div class="showcase">
      <article class="card card-follow" data-reveal>
        <div class="demo demo-follow" aria-hidden="true" data-follow-demo>
          <div class="ch"><span class="hash">#</span>Lobby<span class="ch-count">5</span></div>
          <div class="ch is-followed">
            <span class="hash">#</span>{t.features.followDemo.channel}
            <svg class="eye" viewBox="0 0 24 24" width="15" height="15"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
            <span class="badge" data-badge>3</span>
          </div>
          <div class="ch"><span class="hash">#</span>Squad A<span class="ch-count">2</span></div>
          <div class="ch dim"><span class="hash">#</span>AFK</div>
          <div class="toast" data-toast><b>{t.features.followDemo.unread}</b> {t.features.followDemo.message}</div>
        </div>
        <h3>{showcase[0].title}</h3>
        <p>{showcase[0].body}</p>
      </article>

      <article class="card card-audio" data-reveal>
        <div class="demo demo-audio" aria-hidden="true">
          <div class="wave-row">
            <span class="wave-label">{t.features.noise.before}</span>
            <svg viewBox="0 0 600 80" preserveAspectRatio="none" class="wave wave-noisy"><path d={noisy} /></svg>
          </div>
          <div class="wave-row">
            <span class="wave-label">{t.features.noise.after}</span>
            <svg viewBox="0 0 600 80" preserveAspectRatio="none" class="wave wave-clean"><path d={clean} /></svg>
          </div>
        </div>
        <h3>{showcase[1].title}</h3>
        <p>{showcase[1].body}</p>
      </article>

      <article class="card card-trust" data-reveal>
        <div class="demo demo-trust" aria-hidden="true">
          <p class="trust-q">{t.features.trustQuestion}</p>
          <p class="trust-host">voice.night-owls.example : 64738</p>
          <p class="trust-label">{t.features.fingerprint}</p>
          <code class="trust-fp" data-scramble={fingerprint}>{fingerprint}</code>
          <div class="trust-actions">
            <span class="fake-btn">{t.features.trustNo}</span>
            <span class="fake-btn fake-btn-primary">{t.features.trustYes}</span>
          </div>
        </div>
        <h3>{showcase[2].title}</h3>
        <p>{showcase[2].body}</p>
      </article>
    </div>

    <ol class="feature-list">
      {
        rest.map((f, i) => (
          <li data-reveal data-spot>
            <span class="feature-no">{String(i + 4).padStart(2, "0")}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="features-more" data-reveal>
      <a class="btn btn-small" href={routes.features[lang]}>{t.features.all}</a>
    </p>
  </div>
</section>

<!-- How it works -->
<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label" data-reveal>{t.how.label}</p>
      <h2 id="how-title" class="h2" data-reveal>{t.how.title}</h2>
      <p class="body" data-reveal>{t.how.body}</p>
    </div>

    <div class="diagram" data-reveal>
      <Diagram lang={lang} />
    </div>

    <div class="how-bottom">
      <div class="link-demo" data-reveal>
        <div class="addressbar" aria-hidden="true">
          <span class="lock">⟶</span>
          <span class="typed" data-type="mumble://voice.night-owls.example/Gaming/Squad%20A"></span><span class="caret"></span>
        </div>
        <h3>{t.how.linkTitle}</h3>
        <p>{t.how.linkBody}</p>
      </div>
      <dl class="facts">
        {
          t.how.facts.map((f) => (
            <div data-reveal>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="section gallery" aria-labelledby="gallery-title">
  <div class="wrap gallery-head">
    <div>
      <p class="label" data-reveal>{t.gallery.label}</p>
      <h2 id="gallery-title" class="h2" data-reveal>{t.gallery.title}</h2>
    </div>
    <div class="gallery-nav">
      <button type="button" class="round-btn" data-gallery-prev aria-label="←">←</button>
      <button type="button" class="round-btn" data-gallery-next aria-label="→">→</button>
    </div>
  </div>
  <ul class="gallery-strip" data-gallery tabindex="0" aria-label={t.gallery.title}>
    {
      t.gallery.items.map((g) => (
        <li>
          <figure>
            <Picture src={shot(g.src)} formats={["avif", "webp"]} widths={[640, 1100]} sizes="(min-width: 900px) 560px, 82vw" alt={g.caption} />
            <figcaption>{g.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<!-- Roadmap -->
<section class="section roadmap" id="roadmap" aria-labelledby="roadmap-title">
  <div class="wrap split split-top">
    <div class="roadmap-intro">
      <p class="label" data-reveal>{t.roadmap.label}</p>
      <h2 id="roadmap-title" class="h2" data-reveal>{t.roadmap.title}</h2>
      <p class="body" data-reveal>{t.roadmap.body}</p>
    </div>
    <ol class="timeline">
      {
        (t.roadmap.steps as { tag: string; title: string; body: string; now?: boolean }[]).map((s) => (
          <li class:list={[{ "is-now": s.now }]} data-reveal>
            <span class="tl-dot" aria-hidden="true" />
            <p class="tl-tag">
              {s.tag}
              {s.now && <em>{t.roadmap.now}</em>}
            </p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="roadmap-more" data-reveal>
      <a class="btn btn-small" href={routes.roadmap[lang]}>{t.roadmap.all}</a>
    </p>
  </div>
</section>

<Download lang={lang} />
