---
// The download card: one big button for the visitor's system (picked in src/scripts/download.ts
// from the browser), the other systems one tab away. Without JS it shows Windows and the tabs
// still link to the full download page.
import CopyButton from "./CopyButton.astro";
import { dicts, routes, type Lang } from "../i18n";
import { PLATFORM_GLYPHS } from "../lib/glyphs";
import {
  formatSize,
  hasHomebrewTap,
  BREW_CASK,
  BREW_FORMULA,
  pkgAddCommand,
  INSTALL_COMMAND,
  RELEASES_URL,
  type Kind,
  type Platform,
  type PlatformAsset,
  type Release,
} from "../lib/release";

interface Props {
  lang: Lang;
  release: Release | null;
  /** Heading level of each panel title: 3 inside a section with its own h2, 2 right under the page title. */
  level?: 2 | 3;
}
const { lang, release, level = 3 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const t = dicts[lang].download;
const s = t.spot;
const tap = await hasHomebrewTap();
// FreeBSD only shows once a release ships its package (0.8.0 and newer).
const platforms: Platform[] = ["windows", "macos", "linux", ...(release?.assets.freebsd.length ? (["freebsd"] as Platform[]) : [])];
const mainKind: Record<Platform, Kind> = { windows: "setup", macos: "dmg", linux: "appimage", freebsd: "pkg" };
const brew: Partial<Record<Platform, string>> = { macos: BREW_CASK, linux: BREW_FORMULA };

const label = (p: Platform, a: PlatformAsset) =>
  p === "macos" && a.arch !== "universal" ? s.macArch[a.arch] : s.arch[a.arch];
const panels = platforms.map((p) => {
  const all = release?.assets[p] ?? [];
  const main = all.filter((a) => a.kind === mainKind[p]);
  const kindOrder = ["setup", "dmg", "appimage", "deb", "rpm", "pkg", "portable", "other"];
  const alts = all
    .filter((a) => !main.includes(a))
    .sort((x, y) => kindOrder.indexOf(x.kind) - kindOrder.indexOf(y.kind) || (x.arch === "arm64" ? 1 : 0) - (y.arch === "arm64" ? 1 : 0));
  return { p, main, alts };
});
import Arrow from "./Arrow.astro";
---

<div class="dl-spot" data-dl-spot data-os="windows" data-version={release?.version}>

  <div class="dl-tabs" role="tablist" aria-label={s.pick}>
    {
      platforms.map((p, i) => (
        <a
          class="dl-tab"
          role="tab"
          href={`${routes.download[lang]}#${p}`}
          data-dl-tab={p}
          aria-selected={i === 0 ? "true" : "false"}
        >
          <svg viewBox={PLATFORM_GLYPHS[p].viewBox} width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d={PLATFORM_GLYPHS[p].d} />
          </svg>
          {t.platforms[p].name}
        </a>
      ))
    }
  </div>

  <p class="dl-mobile" data-dl-mobile hidden>
    {s.mobile} <a href={`${routes.roadmap[lang]}`}>{s.mobileLink}<Arrow /></a>
  </p>

  {
    panels.map(({ p, main, alts }) => (
      <div class="dl-panel" role="tabpanel" data-for={p}>
        <div class="dl-body">
          <p class="dl-kicker">
            <span class="dl-detected" data-dl-detected hidden>
              <span class="live-dot" aria-hidden="true" />
              {s.detected}
            </span>
            {release && (
              <span>
                Mumcord <span data-dl-ver>{release.version}</span>
                {release.prerelease && ` · ${t.prerelease}`}
              </span>
            )}
          </p>
          <Heading class="dl-title">
            {s.for} {t.platforms[p].name}
          </Heading>
          <p class="dl-sub">{t.platforms[p].sub}</p>

          <div class="dl-buttons">
            {main.length ? (
              main.map((a, i) => (
                <a class="dl-btn" href={a.url} rel="noopener" data-platform={p} data-kind={a.kind} data-arch={a.arch} data-name={a.name} data-main={i === 0 ? "" : undefined}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
                  </svg>
                  <span class="dl-btn-text">
                    {s.button}
                    {main.length > 1 && <span class="dl-btn-arch">{label(p, a)}</span>}
                  </span>
                  <span class="dl-btn-size" data-size>{formatSize(a.size)}</span>
                </a>
              ))
            ) : (
              <a class="dl-btn" data-main href={release?.url ?? RELEASES_URL} rel="noopener">
                <span class="dl-btn-text">{t.testBuilds}</span>
              </a>
            )}
          </div>
          {main[0] && <p class="dl-file" data-dl-file>{main[0].name}</p>}

          {(p === "windows" || p === "macos") && release?.signed[p] ? (
            <p class="dl-signed">{t.signed[p]}</p>
          ) : (
            <p class="dl-warn">{t.platforms[p].warn}</p>
          )}

        </div>

          {(alts.length > 0 || brew[p] || (p === "linux" && release?.installer) || (p === "freebsd" && main[0])) && (
            <div class="dl-also">
              <p class="dl-also-head">{s.also}</p>
              {p === "freebsd" && main[0] && (
                <div class="dl-cmd">
                  <span class="dl-cmd-label">{s.pkgAdd}</span>
                  <code>
                    <span aria-hidden="true">$ </span>
                    {pkgAddCommand(main[0].name)}
                  </code>
                  <CopyButton text={pkgAddCommand(main[0].name)} label={t.oneLine.copy} copied={t.oneLine.copied} failed={t.oneLine.failed} />
                </div>
              )}
              {p === "linux" && release?.installer && (
                <div class="dl-cmd">
                  <span class="dl-cmd-label">{s.orLine}</span>
                  <code>
                    <span aria-hidden="true">$ </span>
                    {INSTALL_COMMAND}
                  </code>
                  <CopyButton text={INSTALL_COMMAND} label={t.oneLine.copy} copied={t.oneLine.copied} failed={t.oneLine.failed} />
                </div>
              )}
              {brew[p] && (
                <div class:list={["dl-cmd", { "is-soon": !tap }]}>
                  <span class="dl-cmd-label">
                    {s.brew} {!tap && <span class="pill">{s.soon}</span>}
                  </span>
                  <code>
                    <span aria-hidden="true">$ </span>
                    {brew[p]}
                  </code>
                  {tap && <CopyButton text={brew[p]!} label={t.oneLine.copy} copied={t.oneLine.copied} failed={t.oneLine.failed} />}
                </div>
              )}
              {alts.length > 0 && (
                <ul class="dl-alts">
                  {alts.map((a) => (
                    <li data-kind={a.kind} data-arch={a.arch}>
                      <a href={a.url} rel="noopener" data-platform={p} data-kind={a.kind} data-arch={a.arch}>
                        <span class="dl-alt-kind">{s.kinds[a.kind]}</span>
                        <span class="dl-alt-arch">{s.arch[a.arch]}</span>
                        <span class="dl-alt-size" data-size>{formatSize(a.size)}</span>
                        <span class="dl-alt-rec">{s.recommended}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
      </div>
    ))
  }
</div>
