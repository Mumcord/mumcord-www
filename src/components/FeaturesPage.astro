---
import { Picture, getImage } from "astro:assets";
import { type Lang } from "../i18n";
import { featuresPage, BUG_URL, IDEA_URL, type Feature } from "../lib/features";
import { getReleases } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = featuresPage[lang];
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.png", { eager: true });
const shot = (name: string) => shots[`../assets/shots/${name}.png`].default;
const withShot = (list: Feature[]) => list.filter((x) => x.shot);
const textOnly = (list: Feature[]) => list.filter((x) => !x.shot);
// A version counts as out once its GitHub release is published; until then its features say "coming in".
const released = new Set((await getReleases()).map((r) => r.version));
// Features a released version removed are left out.
const f = { ...page, groups: page.groups.map((g) => ({ ...g, features: g.features.filter((x) => !(x.until && released.has(x.until))) })) };
const all = f.groups.flatMap((g) => g.features);
const versions = [...new Set(all.map((x) => x.since).filter((v): v is string => !!v))].sort((a, b) =>
  a.localeCompare(b, "en", { numeric: true }),
);
const hasBeta = all.some((x) => x.beta);
const sinceLabel = (v: string) => `${released.has(v) ? f.newIn : f.comingIn} ${v}`;
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const newest = versions[versions.length - 1];
// Only the two newest versions get a filter; older ones are part of the basics by now.
const filterVersions = versions.slice(-2);
const newestCount = all.filter((x) => x.since === newest).length;
// Shots first: the first one in a group gets the wide card, the others medium cards, text-only ones small cards.
const ordered = (list: Feature[]) => [...withShot(list), ...textOnly(list)];
const size = (x: Feature, i: number) => (!x.shot ? "sm" : i === 0 ? "lg" : "md");
const pad = (n: number) => String(n).padStart(2, "0");
// Full-size WebP for the lightbox, so a click doesn't load the original PNG.
const full = new Map<string, string>();
for (const g of f.groups)
  for (const x of withShot(g.features))
    if (!full.has(x.shot!)) full.set(x.shot!, (await getImage({ src: shot(x.shot!), format: "webp", width: 2400, quality: 82 })).src);
---

<article class="features-page">
  <header class="wrap fp-head">
    <div class="fp-head-glow" aria-hidden="true"></div>
    <p class="label" data-reveal>{f.label}</p>
    <h1 class="fp-title" data-reveal>{f.title}</h1>
    <p class="body" data-reveal>{f.intro}</p>
    <p class="fp-actions" data-reveal>
      <a class="btn btn-small btn-glow" href={IDEA_URL} rel="noopener">{f.idea}</a>
      <a class="text-link" href={BUG_URL} rel="noopener">{f.bug} →</a>
    </p>
    <dl class="fp-stats" data-reveal>
      <div><dt>{f.statFeatures}</dt><dd>{all.length}</dd></div>
      <div><dt>{f.statAreas}</dt><dd>{f.groups.length}</dd></div>
      <div><dt>{released.has(newest) ? f.statNew : f.comingIn} {newest}</dt><dd>{newestCount}</dd></div>
      <div><dt>{f.statPlatforms}</dt><dd>3</dd></div>
    </dl>
  </header>

  <div class="fp-bar" data-fp-bar>
    <div class="wrap fp-bar-inner">
      <div class="fp-filter" role="group" aria-label={f.filterLabel} data-filter-bar>
        <span class="fp-row-label" aria-hidden="true">{f.filterLabel}</span>
        <button type="button" aria-pressed="true" data-filter="all">{f.filterAll}</button>
        {hasBeta && <button type="button" aria-pressed="false" data-filter="beta">{f.filterBeta}</button>}
        {filterVersions.map((v) => <button type="button" aria-pressed="false" data-filter={`v${v}`}>{cap(sinceLabel(v))}</button>)}
      </div>
      <nav class="fp-toc" aria-label={f.contents} data-toc>
        <span class="fp-row-label" aria-hidden="true">{f.jump}</span>
        {f.groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
    </div>
  </div>

  <div class="wrap">
    {
      f.groups.map((g, gi) => (
        <section class="fp-group" id={g.id} aria-labelledby={`${g.id}-h`} data-feature-group>
          <header class="fp-group-head" data-reveal>
            <span class="fp-group-num" aria-hidden="true">{pad(gi + 1)}</span>
            <h2 id={`${g.id}-h`}>{g.title}</h2>
            <span class="fp-group-count">{g.features.length} {f.count}</span>
          </header>
          <div class="fp-bento">
            {ordered(g.features).map((x, i) => (
              <article class={`fp-card fp-card-${size(x, i)}`} id={x.id} data-feature data-since={x.since} data-beta={x.beta ? "" : undefined} data-reveal data-spot>
                {x.shot && (
                  <a class="fp-media" href={full.get(x.shot)} aria-label={`${f.zoom}: ${x.alt}`} data-lightbox data-caption={x.title} data-alt={x.alt}>
                    <Picture src={shot(x.shot)} formats={["avif", "webp"]} widths={[640, 1100, 1600]} sizes={size(x, i) === "lg" ? "(min-width: 960px) 760px, 92vw" : "(min-width: 960px) 560px, 92vw"} alt={x.alt ?? ""} />
                    <span class="fp-zoom" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                    </span>
                  </a>
                )}
                <div class="fp-body">
                  {(x.since || x.beta) && (
                    <p class="fp-pills">
                      {x.since && <span class:list={["pill", { "pill-new": x.since === newest }]}>{sinceLabel(x.since)}</span>}
                      {x.beta && <span class="pill pill-beta">{f.beta}</span>}
                    </p>
                  )}
                  <h3>
                    <a href={`#${x.id}`}>{x.title}</a>
                  </h3>
                  <p>{x.body}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }

    <p class="fp-empty" data-filter-empty hidden>{f.filterEmpty}</p>

    <section class="fp-ask" aria-labelledby="ask-h" data-reveal>
      <h2 id="ask-h">{f.askTitle}</h2>
      <p>{f.askBody}</p>
      <p class="fp-actions">
        <a class="btn btn-small" href={IDEA_URL} rel="noopener">{f.idea}</a>
        <a class="btn btn-small btn-ghost" href={BUG_URL} rel="noopener">{f.bug}</a>
      </p>
      <p class="fp-note">{f.bugNote}</p>
    </section>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label={f.zoom}>
    <figure>
      <img alt="" data-lightbox-img />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-lightbox-close aria-label={f.close}>×</button>
    <button type="button" class="lb-btn lb-prev" data-lightbox-prev aria-label={f.prev}>‹</button>
    <button type="button" class="lb-btn lb-next" data-lightbox-next aria-label={f.next}>›</button>
  </dialog>
</article>
