---
// The roadmap at a glance: the epic in work as one card, the rest as quiet rows. Every epic
// links to its own page (EpicPage.astro) with all groups, ticks and mockups.
import { routes, type Lang } from "../i18n";
import { roadmapPage, resolveEpics, epicProgress, type Stage } from "../lib/roadmap";
import { IDEA_URL } from "../lib/features";
import { getReleases } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = roadmapPage[lang];
const releases = await getReleases();
// An epic counts as done once the GitHub release of its version is out.
const r = { ...page, epics: resolveEpics(page, new Set(releases.map((x) => x.version))) };
const href = (s: Stage) => `${routes.roadmap[lang]}/${s.id}`;
const progressLabel = (s: Stage) => {
  const { done, total } = epicProgress(s);
  return r.epicProgress.replace("{done}", String(done)).replace("{total}", String(total));
};
const done = r.epics.filter((s) => s.status === "done");
const open = r.epics.filter((s) => s.status !== "done");
const current = open[0];
const after = open.slice(1);
const cur = current && epicProgress(current);
---

<article class="wrap roadmap-page rmx">
  <header class="rmx-hero">
    <p class="label" data-reveal>{r.label}</p>
    <h1 class="rm-title" data-reveal>{r.title}</h1>
    <p class="rm-intro" data-reveal>{r.intro}</p>
    <ol class="rmx-steps" aria-label={`${done.length}/${r.epics.length} ${r.statDone}`} data-reveal>
      {
        r.epics.map((s) => (
          <li data-status={s === current ? "current" : s.status}>
            <a href={href(s)} title={`${s.tag}: ${s.title}`}>
              <span class="sr-only">
                {s.tag}: {s.title} ({r.status[s.status]})
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="rmx-count" data-reveal>
      {done.length}/{r.epics.length} {r.statDone} · {releases.length} {r.statReleases}
    </p>
  </header>

  {
    current && cur && (
      <section class="rmx-now" aria-labelledby="rmx-now-h" data-reveal>
        <div class="rmx-now-main">
          <p class="rm-meta">
            <span class="rm-status">
              <span class="live-dot" aria-hidden="true" />
              {r.status[current.status]}
            </span>
            <span>{current.tag}</span>
            {current.version && <span class="pill">v{current.version}</span>}
          </p>
          <h2 id="rmx-now-h">
            <a href={href(current)}>{current.title}</a>
          </h2>
          <p class="rm-summary">{current.summary}</p>
          {cur.total > 0 && (
            <div class="epic-progress">
              <span class="epic-bar" style={`--p: ${cur.done / cur.total}`} aria-hidden="true" />
              <span>{progressLabel(current)}</span>
            </div>
          )}
          <p>
            <a class="btn btn-small" href={href(current)}>{r.epicOpen} →</a>
          </p>
        </div>
        {current.groups && (
          <ul class="rmx-groups">
            {current.groups.map((g) => (
              <li>
                <span>{g.title}</span>
                <span class="rmx-groups-n">{`${g.done?.length ?? 0}/${g.items.length}`}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {
    after.length > 0 && (
      <section class="rmx-section" aria-labelledby="rmx-after-h">
        <h2 id="rmx-after-h" class="rmx-h" data-reveal>{r.laterTitle}</h2>
        <ul class="rmx-rows">
          {after.map((s) => {
            const p = epicProgress(s);
            return (
              <li data-reveal>
                <a href={href(s)}>
                  <span class="rmx-tag">{s.tag}</span>
                  <h3>{s.title}</h3>
                  <span class="rmx-state">{p.done > 0 ? `${p.done}/${p.total}` : s.version ? `v${s.version}` : r.status[s.status]}</span>
                  <p>{s.summary}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    done.length > 0 && (
      <section class="rmx-section" aria-labelledby="rmx-done-h">
        <h2 id="rmx-done-h" class="rmx-h" data-reveal>{r.doneTitle}</h2>
        <ul class="rmx-rows">
          {[...done].reverse().map((s) => (
            <li data-reveal>
              <a href={href(s)}>
                <span class="rmx-tag">{s.tag}</span>
                <h3>{s.title}</h3>
                <span class="rmx-state is-done">✓ {s.version ? `v${s.version}` : r.status.done}</span>
                <p>{s.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="fp-ask" aria-labelledby="rp-ask-h" data-reveal>
    <h2 id="rp-ask-h">{r.ideaTitle}</h2>
    <p>{r.ideaBody}</p>
    <p class="fp-actions">
      <a class="btn btn-small" href={IDEA_URL} rel="noopener">{r.idea}</a>
      <a class="text-link" href={routes.changelog[lang]}>{r.changelog} →</a>
    </p>
  </section>
</article>
