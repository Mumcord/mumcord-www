---
import { routes, type Lang } from "../i18n";
import { roadmapPage, type Stage } from "../lib/roadmap";
import { IDEA_URL } from "../lib/features";
import { getReleases } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = roadmapPage[lang];
// An epic counts as done once the GitHub release of its version is out.
const released = new Set((await getReleases()).map((x) => x.version));
const r = { ...page, epics: page.epics.map((s) => (s.version && released.has(s.version) ? { ...s, status: "done" as const } : s)) };
const sections: { id: string; title: string; body: string; stages: Stage[] }[] = [
  { id: "epics", title: r.epicsTitle, body: r.epicsBody, stages: r.epics },
];
---

<article class="wrap roadmap-page">
  <header class="rp-head">
    <p class="label" data-reveal>{r.label}</p>
    <h1 class="h2" data-reveal>{r.title}</h1>
    <p class="body" data-reveal>{r.intro}</p>
    <nav class="fp-toc" aria-label={r.title} data-reveal>
      {r.epics.map((s) => <a href={`#${s.id}`} data-status={s.status}>{s.tag}</a>)}
    </nav>
  </header>

  {
    sections.map((sec) => (
      <section class="rp-section" id={sec.id} aria-labelledby={`${sec.id}-h`}>
        <h2 id={`${sec.id}-h`} data-reveal>{sec.title}</h2>
        <p class="rp-section-body" data-reveal>{sec.body}</p>
        <ol class="rp-stages">
          {sec.stages.map((s) => (
            <li class="rp-stage" id={s.id} data-status={s.status} data-reveal>
              <div class="rp-side">
                <p class="tl-tag">{s.tag}</p>
                <p class="rp-status">
                  <span class="rp-dot" aria-hidden="true" />
                  {r.status[s.status]}
                  {s.version && <span class="rp-version">v{s.version}</span>}
                </p>
              </div>
              <div class="rp-main">
                <h3>
                  <a href={`#${s.id}`}>{s.title}</a>
                </h3>
                <p class="rp-summary">{s.summary}</p>
                {s.items && (
                  <ul>
                    {s.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                )}
                {s.groups?.map((g) => (
                  <div class="rp-group">
                    <h4>
                      {g.title} {g.version && <span class="rp-version">v{g.version}</span>}
                    </h4>
                    <ul>
                      {g.items.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }


  <section class="fp-ask" aria-labelledby="rp-ask-h" data-reveal>
    <h2 id="rp-ask-h">{r.ideaTitle}</h2>
    <p>{r.ideaBody}</p>
    <p class="fp-actions">
      <a class="btn btn-small" href={IDEA_URL} rel="noopener">{r.idea}</a>
      <a class="text-link" href={routes.changelog[lang]}>{r.changelog} →</a>
    </p>
  </section>
</article>
