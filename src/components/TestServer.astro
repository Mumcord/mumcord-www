---
// The banner for the public test server: a mumble:// link opens it in Mumcord, the address can be copied.
import { dicts, routes, type Lang } from "../i18n";
import CopyButton from "./CopyButton.astro";
import Arrow from "./Arrow.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang].testServer;
const TEST_SERVER = "server.mumcord.app";
---

<section class="wrap ts-banner" aria-labelledby="ts-title" data-reveal>
  <span class="ts-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M4 13a8 8 0 0 1 16 0M4 13v4a2 2 0 0 0 2 2h1v-6H4M20 13v4a2 2 0 0 1-2 2h-1v-6h3" /></svg>
  </span>
  <div class="ts-text">
    <p class="ts-kicker"><span class="live-dot" aria-hidden="true"></span>{t.kicker}</p>
    <h2 id="ts-title">{t.title}</h2>
    <p>{t.body}</p>
  </div>
  <div class="ts-actions">
    <a class="btn btn-small btn-glow" href={`mumble://${TEST_SERVER}`}>{t.join}<Arrow /></a>
    <span class="ts-address">
      <code>{TEST_SERVER}</code>
      <CopyButton text={TEST_SERVER} label={t.copy} copied={t.copied} class="is-quiet" />
    </span>
    <a class="text-link" href={routes.download[lang]}>{t.download}<Arrow /></a>
  </div>
</section>
