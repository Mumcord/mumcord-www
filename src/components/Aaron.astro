---
import SVG from "../assets/aaron.svg?raw";

// Aaron, Mumcord's mascot: an axolotl whose gills are a live equalizer. The eyes follow the
// pointer, it talks while someone speaks and can point at things (src/scripts/aaron.ts).
interface Props {
  /** Unique per page: the SVG's gradient and clip ids are prefixed with it. */
  id: string;
  /** Optional role on the page; src/scripts/aaron.ts wires talking and pointing by it. */
  role?: "hero" | "ptt" | "download";
  class?: string;
}
const { id, role, class: cls } = Astro.props;
const svg = SVG.replaceAll("__UID__", `aaron-${id}`);
---

<div class:list={["aaron", cls]} data-aaron={role ?? ""}>
  <Fragment set:html={svg} />
  <slot />
</div>

