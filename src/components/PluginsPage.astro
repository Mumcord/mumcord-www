---
import { Image } from "astro:assets";
import CopyButton from "./CopyButton.astro";
import PeopleList from "./PeopleList.astro";
import mumcordIcon from "../assets/mumcord-icon.png";
import pollIcon from "../assets/plugins/poll.png";
import diceIcon from "../assets/plugins/dice.png";
import echolingsIcon from "../assets/plugins/echolings.png";
import musicIcon from "../assets/plugins/mumbot-music.png";
import eveIcon from "../assets/plugins/eve-fit.png";
import { highlight } from "../lib/highlight";
import { type Lang } from "../i18n";
import { getRepoContributors } from "../lib/contributors";
import {
  pluginsPage,
  pluginSource,
  pluginDoc,
  pluginDocPage,
  pluginInstall,
  pluginPage,
  PLUGIN_DOCS_URL,
  PLUGIN_WIKI_URL,
  PLUGIN_SDK,
  PLUGIN_SHOTS,
  PLUGIN_IDS,
  PLUGIN_SOON,
  PLUGIN_QUICKSTART,
  PLUGIN_DOCS,
  PLUGINS_REPO,
  PLUGINS_REPO_URL,
  EFT_SAMPLE,
  EVESHIPFIT_URL,
  type PluginId,
} from "../lib/plugins";
import "../styles/plugins.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pluginsPage[lang];
const m = p.mock;
const people = await getRepoContributors(PLUGINS_REPO);
const icons: Partial<Record<PluginId, ImageMetadata>> = { poll: pollIcon, dice: diceIcon, echolings: echolingsIcon, "mumbot-music": musicIcon, "eve-fit": eveIcon };
// `code` in the texts becomes <code>; everything else is escaped.
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
const shotFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/plugin-*.png", { eager: true });
const shot = (name: string) => shotFiles[`../assets/shots/${name}.png`].default;
const pollVotes = [2, 4, 1];
const pollMax = Math.max(...pollVotes);
// The bento layout: wide cards for the richer illustrations.
const span: Record<PluginId, string> = { poll: "wide", dice: "", echolings: "", "mumbot-music": "wide", "eve-fit": "full" };
const safeIcons: Record<keyof typeof p.safe, string> = {
  sandbox: "M12 3 4 6.5v5.2c0 4.6 3.4 8.4 8 9.3 4.6-.9 8-4.7 8-9.3V6.5L12 3ZM9 12l2 2 4-4",
  permissions: "M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12ZM12 14.8a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z",
  signed: "M7 11V7.5a5 5 0 0 1 10 0V11M5 11h14v10H5zM12 15v2",
  server: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01",
  off: "M12 3v8M6.4 6.6a8 8 0 1 0 11.2 0",
  langs: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3.5 9h17M3.5 15h17M12 3c2.3 2.4 3.5 5.4 3.5 9s-1.2 6.6-3.5 9c-2.3-2.4-3.5-5.4-3.5-9S9.7 5.4 12 3Z",
};
const safeOrder = Object.keys(safeIcons) as (keyof typeof p.safe)[];
const eft = EFT_SAMPLE.split("\n");
// The fitting wheel of the EVE Fit illustration: high slots on top, mids right, lows left, rigs below.
const ring = (kind: string, angles: number[]) =>
  angles.map((a) => ({ kind, x: 100 + 82 * Math.cos((a * Math.PI) / 180), y: 100 + 82 * Math.sin((a * Math.PI) / 180), rot: a + 90 }));
const wheel = [
  ...ring("hi", [-114, -100, -86]),
  ...ring("empty", [-72]),
  ...ring("mid", [-22, -8]),
  ...ring("empty", [6]),
  ...ring("lo", [190, 204]),
  ...ring("rig", [76, 90, 104]),
];
const EVE_STATS: [string, string][] = [
  ["Capacitor", "Stable"],
  ["Offense", "112 dps"],
  ["Defense", "4,180 ehp"],
  ["Targeting", "24.00 km"],
  ["Navigation", "1,034 m/s"],
];
---

<article class="plg">
  <div class="plg-aurora" aria-hidden="true"><span></span><span></span><span></span></div>

  <header class="wrap plg-hero">
    <div class="plg-hero-text">
      <p class="plg-badge" data-reveal><span class="live-dot" aria-hidden="true"></span>{p.badge}</p>
      <h1 class="plg-title" data-reveal>{p.title}</h1>
      <p class="body plg-intro" data-reveal>{p.intro}</p>
      <ul class="plg-pills" data-reveal>{p.pills.map((x) => <li>{x}</li>)}</ul>
      <p class="plg-cta" data-reveal>
        <a class="btn btn-primary btn-glow" href="#plugins">{p.ctaPlugins}</a>
        <a class="btn btn-ghost" href="#develop">{p.ctaDev}</a>
      </p>
    </div>
    <div class="plg-orbit" aria-hidden="true" data-reveal style={`--n:${PLUGIN_IDS.length}`}>
      <div class="plg-ring plg-ring-1"></div>
      <div class="plg-ring plg-ring-2"></div>
      <div class="plg-core"><Image src={mumcordIcon} alt="" width={96} height={96} loading="eager" /></div>
      {
        PLUGIN_IDS.map((id, i) => (
          <div class="plg-sat" style={`--i:${i}`}>
            <Image src={icons[id]!} alt="" width={88} height={88} loading="eager" />
          </div>
        ))
      }
    </div>
  </header>

  <section class="wrap plg-section" id="plugins" aria-labelledby="plg-list-h">
    <div class="plg-head">
      <h2 id="plg-list-h" class="h2" data-reveal>{p.listTitle}</h2>
      <p class="body" data-reveal>{p.listBody}</p>
    </div>

    <div class="plg-bento">
      {
        PLUGIN_IDS.map((id) => {
          const x = p.plugins[id];
          const soon = PLUGIN_SOON[id];
          return (
            <section class:list={["plg-card", `plg-card-${id}`, span[id] && `is-${span[id]}`, { "is-soon": soon }]} aria-labelledby={`plg-${id}`} data-reveal>
              <div class="plg-card-text">
                <div class="plg-card-head">
                  {icons[id] ? (
                    <Image class="plg-icon" src={icons[id]!} alt="" width={56} height={56} />
                  ) : (
                    <svg class="plg-icon plg-icon-eve" viewBox="0 0 56 56" aria-hidden="true">
                      <path d="M28 6 47 17v22L28 50 9 39V17L28 6Z" />
                      <path d="M28 15 39 21.5v13L28 41l-11-6.5v-13L28 15Z" />
                      <path d="M28 15v26M17 21.5l22 13M39 21.5l-22 13" />
                    </svg>
                  )}
                  <h3 id={`plg-${id}`}>{x.name}</h3>
                  {soon && <span class="pill plg-soon">{p.soon}</span>}
                </div>
                <p class="plg-tagline" set:html={md(x.tagline)} />
                <ul class="plg-points">
                  {x.points.map((pt) => (
                    <li set:html={md(pt)} />
                  ))}
                </ul>
                {id === "eve-fit" && (
                  <p class="plg-legal">
                    {p.eveNotice}{" "}
                    <a href={EVESHIPFIT_URL} rel="noopener">
                      {p.eveCredit}
                    </a>
                  </p>
                )}
                <p class="plg-actions">
                  {!soon && (
                    <a class="btn btn-primary plg-install" href={pluginInstall(id)}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>
                      {p.install}
                    </a>
                  )}
                  <a class="text-link" href={pluginPage(id)} rel="noopener">{p.pluginPage} →</a>
                  <a class="text-link" href={pluginSource(id)} rel="noopener">{p.source} →</a>
                </p>
              </div>

              <div class="plg-mock" aria-hidden="true">
                {id === "poll" && (
                  <div class="mk-poll">
                    <div class="mk-poll-top">
                      <b>{m.pollQuestion}</b>
                      <span class="mk-live">
                        <i />
                        {m.pollLive}
                      </span>
                    </div>
                    {m.pollOptions.map((o, i) => (
                      <div class="mk-bar" style={`--w:${(pollVotes[i] / pollMax) * 100}%;--d:${i * 0.25}s`}>
                        <span class="mk-bar-fill" />
                        <span class="mk-bar-label">
                          <em>{i + 1}</em>
                          {o}
                        </span>
                        <span class="mk-bar-n">{pollVotes[i]}</span>
                      </div>
                    ))}
                    <p class="mk-foot">{m.pollVotes}</p>
                  </div>
                )}
                {id === "dice" && (
                  <div class="mk-dice">
                    <p class="mk-cmd">
                      <code>/roll 2d6+3</code>
                    </p>
                    <div class="mk-dice-row">
                      {[5, 3].map((n, i) => (
                        <span class="mk-die" style={`--d:${i * 0.15}s`}>
                          {Array.from({ length: n }, () => (
                            <i />
                          ))}
                        </span>
                      ))}
                      <span class="mk-plus">+3</span>
                      <span class="mk-eq">=</span>
                      <span class="mk-total">11</span>
                    </div>
                    <p class="mk-witness">
                      <span class="mk-faces">
                        <i />
                        <i />
                        <i />
                      </span>
                      {m.rollWitness}
                    </p>
                    <p class="mk-history">▸ {m.rollHistory}</p>
                  </div>
                )}
                {id === "echolings" && (
                  <div class="mk-echo">
                    <div class="mk-echo-stage">
                      <span class="mk-wave" />
                      <span class="mk-wave" style="--d:1.2s" />
                      <span class="mk-wave" style="--d:2.4s" />
                      <Image class="mk-echo-pet" src={echolingsIcon} alt="" width={112} height={112} />
                    </div>
                    <div class="mk-growth">
                      {[0, 1, 2, 3].map((s) => (
                        <span style={`--s:${s}`} />
                      ))}
                    </div>
                    <ul class="mk-chips">
                      {m.echoStats.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {id === "mumbot-music" && (
                  <div class="mk-music">
                    <div class="mk-menu">
                      <span class="mk-menu-user">
                        <i />
                        mumbot
                      </span>
                      <span class="mk-menu-item">{m.musicMenu}</span>
                    </div>
                    <div class="mk-remote">
                      <p class="mk-label">{m.musicNow}</p>
                      <div class="mk-track">
                        <span class="mk-art">
                          <i />
                          <i />
                          <i />
                          <i />
                        </span>
                        <span>
                          <b>{m.musicTrack}</b>
                          <small>{m.musicArtist}</small>
                        </span>
                        <span class="mk-skip">
                          <svg viewBox="0 0 24 24">
                            <path d="M5 5l9 7-9 7V5ZM18 5v14" />
                          </svg>
                        </span>
                      </div>
                      <span class="mk-progress">
                        <i />
                      </span>
                      <div class="mk-volume">
                        <svg viewBox="0 0 24 24">
                          <path d="M4 9h4l5-4v14l-5-4H4V9ZM16.5 8.5a5 5 0 0 1 0 7" />
                        </svg>
                        <span>
                          <i />
                        </span>
                      </div>
                      <p class="mk-label">{m.musicQueue}</p>
                      <ol class="mk-queue">
                        {m.musicQueueItems.map((q) => (
                          <li>{q}</li>
                        ))}
                      </ol>
                      <span class="mk-add">+ {m.musicAdd}</span>
                    </div>
                  </div>
                )}
                {id === "eve-fit" && (
                  <div class="mk-eve">
                    <pre class="mk-eft">
                      {eft.map((l) => (
                        <span>{l || " "}</span>
                      ))}
                    </pre>
                    <span class="mk-arrow">
                      <svg viewBox="0 0 24 24">
                        <path d="M4 12h15M13 6l6 6-6 6" />
                      </svg>
                    </span>
                    <div class="mk-fit">
                      <div class="mk-fit-head">
                        <Image src={eveIcon} alt="" width={40} height={40} />
                        <span>
                          <b>Evening patrol</b>
                          <small>Rifter · {m.evePasted}</small>
                        </span>
                        <span class="mk-fit-copy">{m.eveCopy}</span>
                        <span class="mk-fit-x">×</span>
                      </div>
                      <div class="mk-fit-body">
                        <svg class="mk-wheel" viewBox="0 0 200 200">
                          <defs>
                            <radialGradient id="mk-hull" cx="50%" cy="45%" r="60%">
                              <stop offset="0" stop-color="#8a5a66" />
                              <stop offset="1" stop-color="#2a1a24" />
                            </radialGradient>
                          </defs>
                          <circle cx="100" cy="100" r="96" class="mk-wheel-rim" />
                          <circle cx="100" cy="100" r="66" fill="url(#mk-hull)" />
                          <path class="mk-wheel-cap" d="M100 4 A96 96 0 0 1 196 100" />
                          <path class="mk-wheel-ship" d="M70 140 L118 66 L134 58 L130 76 L84 146 Z M104 98 L126 108 L118 116 Z M92 90 L78 76 L88 74 Z" />
                          {wheel.map((w) => (
                            <rect class={`mk-slot is-${w.kind}`} x={w.x - 9} y={w.y - 9} width="18" height="18" rx="3" transform={`rotate(${w.rot} ${w.x} ${w.y})`} />
                          ))}
                        </svg>
                        <dl class="mk-stats">
                          {EVE_STATS.map(([k, v]) => (
                            <div>
                              <dt>▾ {k}</dt>
                              <dd>{v}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
    <p class="plg-note" data-reveal>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 11v5M12 7.5h.01" /></svg>
      {p.installNote}
    </p>
  </section>

  <section class="wrap plg-section plg-gallery" id="screenshots" aria-labelledby="plg-gallery-h" data-mode="dark">
    <div class="plg-head plg-gallery-head">
      <div>
        <p class="label" data-reveal>{p.galleryLabel}</p>
        <h2 id="plg-gallery-h" class="h2" data-reveal>{p.galleryTitle}</h2>
        <p class="body" data-reveal>{p.galleryBody}</p>
      </div>
      <div class="plg-modes" role="group" aria-label={p.galleryLabel} data-reveal>
        <button type="button" data-set-mode="dark" aria-pressed="true">{p.dark}</button>
        <button type="button" data-set-mode="light" aria-pressed="false">{p.light}</button>
      </div>
    </div>
    <ul class="plg-shots">
      {
        PLUGIN_SHOTS.map((s, i) => (
          <li class:list={["plg-shot", `plg-shot-${s.key}`]} data-reveal style={`--i:${i % 3}`}>
            <figure>
              <div class="plg-shot-frame">
                <a href={shot(`${s.shot}-dark`).src} class="plg-shot-dark">
                  <Image src={shot(`${s.shot}-dark`)} alt={p.shots[s.key].alt} widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 50vw" />
                </a>
                {s.light && (
                  <a href={shot(`${s.shot}-light`).src} class="plg-shot-light">
                    <Image src={shot(`${s.shot}-light`)} alt={p.shots[s.key].alt} widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 50vw" />
                  </a>
                )}
              </div>
              <figcaption>{p.shots[s.key].caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap plg-section" aria-labelledby="plg-bridge-h">
    <div class="plg-head">
      <h2 id="plg-bridge-h" class="h2" data-reveal>{p.bridgeTitle}</h2>
      <p class="body" data-reveal>{p.bridgeBody}</p>
    </div>
    <div class="plg-bridge" data-reveal>
      <figure class="plg-pane plg-pane-mumcord">
        <figcaption>{p.bridgeMumcord}</figcaption>
        <div class="mk-poll is-compact" aria-hidden="true">
          <div class="mk-poll-top">
            <b>{m.pollQuestion}</b>
            <span class="mk-live"><i />{m.pollLive}</span>
          </div>
          {
            m.pollOptions.map((o, i) => (
              <div class="mk-bar" style={`--w:${(pollVotes[i] / pollMax) * 100}%;--d:${i * 0.25}s`}>
                <span class="mk-bar-fill" />
                <span class="mk-bar-label">
                  <em>{i + 1}</em>
                  {o}
                </span>
                <span class="mk-bar-n">{pollVotes[i]}</span>
              </div>
            ))
          }
        </div>
      </figure>
      <span class="plg-bridge-link" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M7 12h10M13 8l4 4-4 4M11 16l-4-4 4-4" /></svg>
      </span>
      <figure class="plg-pane plg-pane-mumble">
        <figcaption>{p.bridgeMumble}</figcaption>
        <div class="mk-log" aria-hidden="true">
          <p><time>20:14</time> <b>mumcord-kim:</b> {m.pollPlain}</p>
          <p><time>20:15</time> <b>alex:</b> {m.pollPlainVote}</p>
        </div>
      </figure>
    </div>
    <p class="plg-note" data-reveal>{p.bridgeNote}</p>
  </section>

  <section class="wrap plg-section" aria-labelledby="plg-install-h">
    <div class="plg-install">
      <div>
        <h2 id="plg-install-h" class="h2" data-reveal>{p.installTitle}</h2>
        <p class="body" data-reveal>{p.installBody}</p>
        <ol class="plg-steps">
          {
            p.steps.map((s, i) => (
              <li data-reveal style={`--i:${i}`}>
                <span class="plg-step-n">{i + 1}</span>
                <span>
                  <b>{s.title}</b>
                  {s.body}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="mk-sidebar" aria-hidden="true" data-reveal>
        <div class="mk-tree">
          {
            p.stripChannels.map((c, i) => (
              <div class:list={["mk-chan", { "is-on": i === 1 }]}>
                <span># {c}</span>
                {i === 1 && (
                  <span class="mk-people">
                    <i />
                    <i />
                    <i />
                  </span>
                )}
              </div>
            ))
          }
        </div>
        <div class="mk-strip">
          <small>{p.stripLabel}</small>
          <span class="mk-strip-icons">
            {
              PLUGIN_IDS.map((id, i) => (
                <span style={`--i:${i}`}>
                  <Image src={icons[id]!} alt="" width={36} height={36} />
                </span>
              ))
            }
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap plg-section" aria-labelledby="plg-safe-h">
    <div class="plg-head">
      <h2 id="plg-safe-h" class="h2" data-reveal>{p.safeTitle}</h2>
      <p class="body" data-reveal>{p.safeBody}</p>
    </div>
    <div class="plg-safe">
      {
        safeOrder.map((k, i) => (
          <section class={`plg-tile plg-tile-${k}`} data-reveal style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={safeIcons[k]} />
            </svg>
            <h3>{p.safe[k].title}</h3>
            <p>{p.safe[k].body}</p>
          </section>
        ))
      }
    </div>
  </section>

  <section class="plg-dev" id="develop" aria-labelledby="plg-dev-h">
    <div class="wrap">
      <div class="plg-dev-grid">
        <div>
          <p class="label" data-reveal>{p.devLabel}</p>
          <h2 id="plg-dev-h" class="h2" data-reveal>{p.devTitle}</h2>
          <p class="body" data-reveal set:html={md(p.devBody)} />
          <div class="plg-stack" data-reveal aria-hidden="true">
            <span>Rust</span>
            <svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            <span>WebAssembly</span>
            <svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            <span>Mumcord</span>
          </div>
        </div>
        <figure class="code plg-code" data-reveal>
          <figcaption>
            <span>Terminal</span>
            <CopyButton label={p.copy} copied={p.copied} class="is-quiet" />
          </figcaption>
          <pre><code set:html={highlight(PLUGIN_QUICKSTART, "shell")} /></pre>
        </figure>
        <p class="plg-sdk" data-reveal>
          {p.sdkNote} <code>{PLUGIN_SDK}</code>
        </p>
      </div>

      <h3 class="plg-sub" data-reveal><code>mumcord-plugin</code> · {p.cliTitle}</h3>
      <ol class="plg-cli">
        {
          p.cli.map((c, i) => (
            <li data-reveal style={`--i:${i}`}>
              <code>{c.cmd}</code>
              <span>{c.body}</span>
            </li>
          ))
        }
      </ol>

      <h3 class="plg-sub" data-reveal>{p.docsTitle}</h3>
      <ul class="plg-docs" data-reveal>
        {
          PLUGIN_DOCS.map((d) => (
            <li>
              <a href={pluginDocPage(d.slug)} rel="noopener">
                {p.docs[d.key]}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={PLUGIN_DOCS_URL} rel="noopener">
            {p.docsAll}
            <span aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={PLUGIN_WIKI_URL} rel="noopener">
            {p.wiki}
            <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>

      <div class="plg-submit">
        <section class="plg-panel" data-reveal>
          <h3>{p.submitTitle}</h3>
          <p set:html={md(p.submitBody)} />
          <p class="plg-mini">{p.checksTitle}</p>
          <ol class="plg-checks">
            {
              p.checks.map((c, i) => (
                <li style={`--i:${i}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  {c}
                </li>
              ))
            }
          </ol>
          <p class="plg-mini">{p.rulesTitle}</p>
          <ul class="plg-rules">{p.rules.map((r) => <li>{r}</li>)}</ul>
          <a class="text-link" href={pluginDoc("policy/REVIEW.md")} rel="noopener">{p.policy} →</a>
        </section>
        <div class="plg-side">
          <section class="plg-panel" data-reveal>
            <h3>{p.ownRepoTitle}</h3>
            <p>{p.ownRepoBody}</p>
            <a class="text-link" href={pluginDocPage("third-party-repositories")} rel="noopener">{p.docs.repos} →</a>
          </section>
          <section class="plg-panel" data-reveal>
            <h3>{p.licenceTitle}</h3>
            <p>{p.licenceBody}</p>
          </section>
        </div>
      </div>
    </div>
  </section>

  {
    people.length > 0 && (
      <section class="wrap plg-section" aria-labelledby="plg-people-h">
        <h2 id="plg-people-h" class="h2" data-reveal>{p.peopleTitle}</h2>
        <PeopleList lang={lang} people={people} />
      </section>
    )
  }

  <section class="wrap plg-end" data-reveal>
    <h2 class="h2">{p.endTitle}</h2>
    <p class="body">{p.endBody}</p>
    <a class="btn btn-primary btn-glow" href={PLUGINS_REPO_URL} rel="noopener">{p.endRepo}</a>
  </section>
</article>

<script>
  // Screenshots: switch between the dark and the light theme.
  for (const g of document.querySelectorAll<HTMLElement>(".plg-gallery")) {
    for (const b of g.querySelectorAll<HTMLButtonElement>("[data-set-mode]")) {
      b.addEventListener("click", () => {
        g.dataset.mode = b.dataset.setMode;
        for (const o of g.querySelectorAll("[data-set-mode]")) o.setAttribute("aria-pressed", String(o === b));
      });
    }
  }
</script>
