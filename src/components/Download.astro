---
import DownloadSpotlight from "./DownloadSpotlight.astro";
import Mimo from "./Mimo.astro";
import { dicts, routes, type Lang, LANG_INFO } from "../i18n";
import { getLatestRelease, RELEASES_URL } from "../lib/release";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang].download;
const release = await getLatestRelease();
const date = release
  ? new Intl.DateTimeFormat(LANG_INFO[lang].intl, { dateStyle: "long" }).format(new Date(release.publishedAt))
  : "";
---

<section class="section download" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <div class="download-head">
      <div>
        <p class="label" data-reveal>{t.label}</p>
        <h2 id="download-title" class="h2" data-reveal>{t.title}</h2>
      </div>
      {
        release ? (
          <div class="release-meta" data-reveal>
            <p class="release-tag">
              <span class="live-dot" aria-hidden="true" />
              {t.latest}: <strong>{release.name}</strong>
              {release.prerelease && <span class="pill">{t.prerelease}</span>}
            </p>
            <p class="release-date">
              {t.published} {date} · <a href={`${routes.changelog[lang]}#v${release.version}`}>{t.notes}</a> · <a href={RELEASES_URL} rel="noopener">{t.allReleases}</a>
            </p>
          </div>
        ) : (
          <div class="release-meta release-none" data-reveal>
            <p>{t.noRelease}</p>
            <p>
              <a class="text-link" href={routes.changelog[lang]}>{dicts[lang].changelog.title} →</a>
              <a class="text-link" href={RELEASES_URL} rel="noopener">{t.testBuilds} →</a>
            </p>
          </div>
        )
      }
    </div>

    <Mimo id="download" role="download" class="mimo-download" />
    <div data-reveal>
      <DownloadSpotlight lang={lang} release={release} />
    </div>

    <a class="dl-all" href={routes.download[lang]} data-reveal>
      {t.spot.all}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
