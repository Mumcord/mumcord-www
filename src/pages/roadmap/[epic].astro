---
import Base from "../../layouts/Base.astro";
import EpicPage from "../../components/EpicPage.astro";
import { roadmapPage } from "../../lib/roadmap";

export const getStaticPaths = () => roadmapPage.de.epics.map((e) => ({ params: { epic: e.id } }));

const r = roadmapPage.de;
const s = r.epics.find((e) => e.id === Astro.params.epic)!;
---

<Base lang="de" page="roadmap" title={`${s.tag}: ${s.title} — Mumcord`} description={s.summary} subpath={`/${s.id}`}>
  <EpicPage lang="de" id={s.id} />
</Base>
