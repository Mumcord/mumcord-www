---
import Base from "../layouts/Base.astro";
import LibPage from "../components/LibPage.astro";
import { libsPage } from "../lib/libs";
import { libJsonLd } from "../lib/jsonld";

const t = libsPage.de;
const p = t.pages.hwcodec;
---

<Base lang="de" page="hwcodec" title={`${p.title} — ${p.menu}`} description={p.description} jsonLd={libJsonLd("de", Astro.site!, "hwcodec")}>
  <LibPage lang="de" lib="hwcodec" />
</Base>
