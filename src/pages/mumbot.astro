---
import Base from "../layouts/Base.astro";
import MumbotPage from "../components/MumbotPage.astro";
import { mumbotPage } from "../lib/mumbot";
import { pageJsonLd } from "../lib/jsonld";

const r = mumbotPage.de;
---

<Base lang="de" page="mumbot" title={`${r.title} — ${r.label}`} description={r.description} jsonLd={pageJsonLd("de", Astro.site!, "mumbot", r.title)}>
  <MumbotPage lang="de" />
</Base>
