---
import Base from "../../layouts/Base.astro";
import ServerGuide from "../../components/ServerGuide.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { guides } from "../../lib/server-guide";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const g = guides[lang];
---

<Base lang={lang} page="server" title={`${g.title} — Mumcord`} description={g.description} jsonLd={pageJsonLd(lang, Astro.site!, "server", g.title)}>
  <ServerGuide lang={lang} />
</Base>
