---
import Base from "../../layouts/Base.astro";
import DownloadPage from "../../components/DownloadPage.astro";
import { dicts, EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const t = dicts[lang].downloadPage;
---

<Base lang={lang} page="download" title={`${t.title} — Mumcord`} description={t.description} jsonLd={pageJsonLd(lang, Astro.site!, "download", t.title)}>
  <DownloadPage lang={lang} />
</Base>
