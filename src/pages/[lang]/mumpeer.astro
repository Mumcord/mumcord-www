---
import Base from "../../layouts/Base.astro";
import ToolPage from "../../components/ToolPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { toolsPage } from "../../lib/tools";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const t = toolsPage[lang];
const p = t.pages.mumpeer;
---

<Base lang={lang} page="mumpeer" title={`${p.title} — ${t.label}`} description={p.description} jsonLd={pageJsonLd(lang, Astro.site!, "mumpeer", p.title)}>
  <ToolPage lang={lang} tool="mumpeer" />
</Base>
