---
import Base from "../../layouts/Base.astro";
import FeaturesPage from "../../components/FeaturesPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { featuresPage } from "../../lib/features";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const f = featuresPage[lang];
---

<Base lang={lang} page="features" title={`${f.title} — Mumcord`} description={f.description} jsonLd={pageJsonLd(lang, Astro.site!, "features", f.title)}>
  <FeaturesPage lang={lang} />
</Base>
