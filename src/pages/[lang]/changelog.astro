---
import Base from "../../layouts/Base.astro";
import Changelog from "../../components/Changelog.astro";
import { dicts, EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const t = dicts[lang].changelog;
---

<Base lang={lang} page="changelog" title={`${t.title} — Mumcord`} description={t.description} jsonLd={pageJsonLd(lang, Astro.site!, "changelog", t.title)}>
  <Changelog lang={lang} />
</Base>
