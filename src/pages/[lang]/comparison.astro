---
import Base from "../../layouts/Base.astro";
import ComparePage from "../../components/ComparePage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { comparePage } from "../../lib/compare";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const t = comparePage[lang];
---

<Base lang={lang} page="compare" title={t.title} description={t.description} jsonLd={pageJsonLd(lang, Astro.site!, "compare", t.title)}>
  <ComparePage lang={lang} />
</Base>
