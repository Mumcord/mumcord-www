---
import Base from "../../layouts/Base.astro";
import MumbotPage from "../../components/MumbotPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { mumbotPage } from "../../lib/mumbot";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const r = mumbotPage[lang];
---

<Base lang={lang} page="mumbot" title={`${r.title} — ${r.label}`} description={r.description} jsonLd={pageJsonLd(lang, Astro.site!, "mumbot", r.title)}>
  <MumbotPage lang={lang} />
</Base>
