---
import Base from "../../layouts/Base.astro";
import GamesPage from "../../components/GamesPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { gamesPage } from "../../lib/games";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const g = gamesPage[lang];
---

<Base lang={lang} page="games" title={`${g.title} — Mumcord`} description={g.description} jsonLd={pageJsonLd(lang, Astro.site!, "games", g.title)}>
  <GamesPage lang={lang} />
</Base>
