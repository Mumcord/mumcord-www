---
import Base from "../../layouts/Base.astro";
import RoadmapPage from "../../components/RoadmapPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { roadmapPage } from "../../lib/roadmap";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const r = roadmapPage[lang];
---

<Base lang={lang} page="roadmap" title={`${r.title} — Mumcord`} description={r.description} jsonLd={pageJsonLd(lang, Astro.site!, "roadmap", r.title)}>
  <RoadmapPage lang={lang} />
</Base>
