---
import Base from "../../layouts/Base.astro";
import PluginsPage from "../../components/PluginsPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../i18n";
import { pluginsPage } from "../../lib/plugins";
import { pageJsonLd } from "../../lib/jsonld";

export const getStaticPaths = () => EXTRA_LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as ExtraLang;
const r = pluginsPage[lang];
---

<Base lang={lang} page="plugins" title={`${r.title} — ${r.label}`} description={r.description} jsonLd={pageJsonLd(lang, Astro.site!, "plugins", r.title)}>
  <PluginsPage lang={lang} />
</Base>
