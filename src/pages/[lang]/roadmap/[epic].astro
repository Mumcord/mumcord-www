---
import Base from "../../../layouts/Base.astro";
import EpicPage from "../../../components/EpicPage.astro";
import { EXTRA_LANGS, type ExtraLang } from "../../../i18n";
import { roadmapPage } from "../../../lib/roadmap";

export const getStaticPaths = () =>
  EXTRA_LANGS.flatMap((lang) => roadmapPage[lang].epics.map((e) => ({ params: { lang, epic: e.id } })));

const lang = Astro.params.lang as ExtraLang;
const r = roadmapPage[lang];
const s = r.epics.find((e) => e.id === Astro.params.epic)!;
---

<Base lang={lang} page="roadmap" title={`${s.tag}: ${s.title} — Mumcord`} description={s.summary} subpath={`/${s.id}`}>
  <EpicPage lang={lang} id={s.id} />
</Base>
