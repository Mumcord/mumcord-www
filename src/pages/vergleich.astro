---
import Base from "../layouts/Base.astro";
import ComparePage from "../components/ComparePage.astro";
import { comparePage } from "../lib/compare";
import { pageJsonLd } from "../lib/jsonld";

const t = comparePage.de;
---

<Base lang="de" page="compare" title={t.title} description={t.description} jsonLd={pageJsonLd("de", Astro.site!, "compare", t.title)}>
  <ComparePage lang="de" />
</Base>
