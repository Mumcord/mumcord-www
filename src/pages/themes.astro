---
import Base from "../layouts/Base.astro";
import ThemesPage from "../components/ThemesPage.astro";
import { themesPage } from "../lib/themes";
import { pageJsonLd } from "../lib/jsonld";

const t = themesPage.de;
---

<Base lang="de" page="themes" title={`${t.title} — Mumcord`} description={t.description} jsonLd={pageJsonLd("de", Astro.site!, "themes", t.title)}>
  <ThemesPage lang="de" />
</Base>
