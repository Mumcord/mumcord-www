---
import Base from "../../layouts/Base.astro";
import DownloadPage from "../../components/DownloadPage.astro";
import { dicts } from "../../i18n";
import { pageJsonLd } from "../../lib/jsonld";

const t = dicts.en.downloadPage;
---

<Base lang="en" page="download" title={`${t.title} — Mumcord`} description={t.description} jsonLd={pageJsonLd("en", Astro.site!, "download", t.title)}>
  <DownloadPage lang="en" />
</Base>
