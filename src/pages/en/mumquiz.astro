---
import Base from "../../layouts/Base.astro";
import ToolPage from "../../components/ToolPage.astro";
import { toolsPage } from "../../lib/tools";
import { pageJsonLd } from "../../lib/jsonld";

const t = toolsPage.en;
const p = t.pages.mumquiz;
---

<Base lang="en" page="mumquiz" title={`${p.title} — ${t.label}`} description={p.description} jsonLd={pageJsonLd("en", Astro.site!, "mumquiz", p.title)}>
  <ToolPage lang="en" tool="mumquiz" />
</Base>
