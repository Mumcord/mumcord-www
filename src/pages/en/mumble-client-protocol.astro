---
import Base from "../../layouts/Base.astro";
import LibPage from "../../components/LibPage.astro";
import { libsPage } from "../../lib/libs";
import { libJsonLd } from "../../lib/jsonld";

const t = libsPage.en;
const p = t.pages.protocol;
---

<Base lang="en" page="protocol" title={`${p.title} — ${p.menu}`} description={p.description} jsonLd={libJsonLd("en", Astro.site!, "protocol")}>
  <LibPage lang="en" lib="protocol" />
</Base>
