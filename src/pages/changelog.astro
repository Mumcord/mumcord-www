---
import Base from "../layouts/Base.astro";
import Changelog from "../components/Changelog.astro";
import { dicts } from "../i18n";
import { pageJsonLd } from "../lib/jsonld";

const t = dicts.de.changelog;
---

<Base lang="de" page="changelog" title={`${t.title} — Mumcord`} description={t.description} jsonLd={pageJsonLd("de", Astro.site!, "changelog", t.title)}>
  <Changelog lang="de" />
</Base>
