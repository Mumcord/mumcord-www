# Static file server for the prerendered site. TLS and host routing are handled
# by Traefik in front of this container, so Caddy only listens on plain :80.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Clean (extensionless) URLs for Astro's "file" build output:
	#   /impressum -> impressum.html, /en -> en.html, /en/privacy -> en/privacy.html
	@trailing path_regexp trailing ^(.+)/$
	redir @trailing {re.trailing.1} 301
	try_files {path} {path}.html {path}/index.html
	# The configurator's compose files: Caddy fills in name, welcome text and numbers from the query
	# string (see src/pages/server/compose/[variant].yml.ts). Values are quoted there, never run.
	@compose path /server/compose/*
	header @compose Content-Type "text/plain; charset=utf-8"
	templates @compose {
		mime text/plain
	}

	file_server

	handle_errors {
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Everything is first-party; the only inline script is the one-line "js" class
		# toggle in Base.astro, allowed by hash. Update the hash if that line changes.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-WZRJfWvsnNCPcxzZwvyhovnZGqhZaC+8gPGPRbx6wTk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
	}

	# Fingerprinted build assets are immutable; HTML and the rest stay short-lived.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@static path /favicon.ico /favicon.png /apple-touch-icon.png /og.jpg
	header @static Cache-Control "public, max-age=2592000"
	@rest not path /_astro/* /favicon.ico /favicon.png /apple-touch-icon.png /og.jpg
	header @rest Cache-Control "public, max-age=300"
}
